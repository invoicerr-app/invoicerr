# Dependencies
/node_modules

# Production
/build

# Generated files
.docusaurus
.cache-loader

# Country compliance matrix — regenerated from backend/src/modules/documents/**/data/*.json by
# scripts/generate-country-matrix.mjs (wired as prebuild/prestart, see package.json). Never
# commit this: a checked-in copy is exactly the kind of doc that can silently drift from the
# data it describes, which is the whole reason this mechanism exists.
/docs/developer-guide/country-support

# The published OpenAPI spec (docs/developer-guide/api-reference.md links to it) — generated by
# `cd backend && npm run openapi:dump` and copied here by `.github/workflows/docs-deploy.yml`. Same
# "never commit a generated doc" reasoning as the country matrix above; a local `npm run build` here
# without that copy step first simply ships the site without it.
/static/openapi.json

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
