# Deployment secrets for docker-compose.yml — copy this file to `.env` and fill in real values.
#
#   cp .env.example .env
#
# Docker Compose reads `.env` from the directory holding the compose file, automatically, for the
# ${...} substitutions in docker-compose.yml and docker-compose.scale.yml. `.env` is gitignored;
# this file is not, so NEVER put a real value here. If your orchestrator has its own secrets
# mechanism (Docker Swarm / Kubernetes secrets, a vault), use that instead and keep these names.
#
# Generate every value below with a fresh, DIFFERENT run of:
#
#   openssl rand -hex 32


# ---------------------------------------------------------------------------------------------
# REQUIRED — the backend refuses to boot in production without it (SECURITY_AUDIT.md finding #3),
# and Compose now refuses even earlier. It signs every session cookie/JWT: a deployment running on
# a publicly known value lets anyone forge a valid session for any userId.
#
# JWT_SECRET is an alias kept for deployments that already set it. ONE of the two is enough — the
# boot guard checks the effective value (BETTER_AUTH_SECRET || JWT_SECRET), not each variable.
# ---------------------------------------------------------------------------------------------
BETTER_AUTH_SECRET=


# ---------------------------------------------------------------------------------------------
# OPTIONAL, but required for per-company channel credentials (KSeF, PDP, SdI…).
#
# Leaving it empty does NOT stop the backend booting: it fails SILENTLY. isEncryptionAvailable()
# in backend/src/utils/secret-crypto.ts returns false and the whole feature switches itself off —
# no client can save the credentials for their own channel, with no error, no log, and nothing on
# screen to explain it.
#
# It encrypts those credentials at rest (AES-256-GCM). Changing it later makes every already-stored
# credential undecryptable — treat it like a database password, not a toggle. Back it up.
#
# On the scaled topology (docker-compose.scale.yml) the API and the worker both read this same
# entry, which is what guarantees they agree: the worker is the process that actually decrypts the
# credentials for a queued send.
# ---------------------------------------------------------------------------------------------
CREDENTIALS_ENCRYPTION_KEY=


# ---------------------------------------------------------------------------------------------
# OPTIONAL — Redis password, empty by default (the bundled Redis is not exposed outside the compose
# network). Set it on both the redis service and the app if you expose Redis.
# ---------------------------------------------------------------------------------------------
REDIS_PASSWORD=


# ---------------------------------------------------------------------------------------------
# OPTIONAL — where the legal document archive's bytes are stored (backend/src/modules/documents/
# archive/). Default is ARCHIVE_STORAGE unset, which means "local", i.e. TODAY'S behavior, unchanged:
# archives are written to the DOCUMENTS_ARCHIVE_DIR path on the container's own filesystem (see
# docker-compose.yml's own DOCUMENTS_ARCHIVE_DIR entry — keep it on the persistent documents_data
# volume, or you lose every archive on the next image pull).
#
# Set ARCHIVE_STORAGE=s3 to write NEW archives to an S3-compatible bucket instead (real AWS S3, or a
# compatible provider such as Scaleway Object Storage) — fill in the six ARCHIVE_S3_* values below.
# Missing any of them while ARCHIVE_STORAGE=s3 makes the backend refuse the write with a clear error
# naming the missing variable, rather than silently keeping the archive on local disk: this is a legal
# archive, and a silent storage-location switch would itself be a compliance defect.
#
# Switching ARCHIVE_STORAGE mid-life (either direction) does NOT migrate anything already archived —
# each archive's own storage location is recorded as a self-describing URI (file://... or s3://...)
# at write time, so archives written under the OLD provider stay fully readable/verifiable after the
# switch; they simply are not moved to the new one.
# ARCHIVE_STORAGE=s3
# ARCHIVE_S3_BUCKET=your-bucket-name
# ARCHIVE_S3_ENDPOINT= # omit entirely for real AWS S3; required for Scaleway: https://s3.fr-par.scw.cloud
# ARCHIVE_S3_REGION=fr-par # e.g. "fr-par" for Scaleway, a real AWS region ("eu-west-3"…) for AWS
# ARCHIVE_S3_ACCESS_KEY_ID=
# ARCHIVE_S3_SECRET_ACCESS_KEY=
# ARCHIVE_S3_FORCE_PATH_STYLE= # "1" or "true" — needed by some S3-compatible endpoints (some Scaleway
# setups included); AWS itself never needs this.
