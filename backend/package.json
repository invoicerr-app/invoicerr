    "openapi:dump": "nest build && node dist/src/openapi-dump.js",
    "backup:encrypt": "tsx src/modules/backup/backup-crypto-cli.ts encrypt",
    "backup:decrypt": "tsx src/modules/backup/backup-crypto-cli.ts decrypt"
