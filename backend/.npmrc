@jsr:registry=https://npm.jsr.io
# @documenso/sdk-typescript@0.4.0 has a peerOptional dependency on an older
# @modelcontextprotocol/sdk range (>=1.5.0 <1.10.0) than the one this project
# actually uses (^1.29.0, for the Invoicerr MCP server). Documenso doesn't
# actually require that peer to be satisfied (it's optional), so this is safe
# to bypass rather than a real conflict — matches the --legacy-peer-deps used
# when this dependency was first installed locally.
legacy-peer-deps=true
