NODE_ENV=test
DATABASE_URL="postgresql://invoicerr:invoicerr@localhost:5433/invoicerr_db"
APP_URL=http://localhost:6284
PORT=4000


SMTP_HOST="localhost" # Change this to your SMTP host
SMTP_USER="test@local.dev" # Change this to your SMTP user
SMTP_FROM="test@local.dev" # Change this to your email address (not required if SMTP_USER is the same)
SMTP_PASSWORD="" # Change this to your SMTP password
SMTP_PORT=1025 # Change this to your SMTP port (default is 587 for TLS)
SMTP_SECURE=false # Set to true if your SMTP server requires a secure connection (default is false)

# Redis for the local e2e stack: the invoicerr-redis-e2e container publishes 6379 on 6399.
# CI does NOT use this value -- both workflows override REDIS_URL at job level, because a runner's
# own redis service listens on 6379 and nothing is on 6399 there. A job that forgets the override
# fails at boot with "Redis is required to boot ... unreachable at redis://localhost:6399", which is
# what silently killed all six Business Scenarios legs between 2026-08-29 and 2026-09-14.
# Locally this line is load-bearing: without it the backend reached the machine's own Redis on 6379,
# which is password-protected -- NOAUTH at boot, BullMQ mute, and `send` doing nothing AT ALL, in
# silence, with two Cypress specs failing for a reason that had nothing to do with them.
REDIS_URL=redis://localhost:6399

# Le balayage des récurrences tourne par défaut toutes les 60s — beaucoup trop
# lent pour un test Cypress (29-document-recurrence.cy.ts) sans le rendre fragile avec un timeout
# démesuré. 5s ici, jamais dans l'assertion elle-même — voir ce fichier de spec pour le timeout
# adapté en conséquence.
DOCUMENT_SCHEDULE_SWEEP_INTERVAL_MS=5000

# Le suivi de conformité post-dépôt tourne par défaut toutes les 60s
# lui aussi — même raison que le sweep des récurrences juste au-dessus : 5s ici pour que les specs
# Cypress/e2e qui attendent un badge de conformité n'aient pas besoin d'un timeout démesuré. Jamais
# dans l'assertion elle-même. `DOCUMENT_CONFORMITY_MAX_POLL_AGE_MS` (l'abandon après N ms sans verdict
# terminal) garde sa valeur de production (7 jours) : aucun test de ce dépôt n'attend un "gave-up".
DOCUMENT_CONFORMITY_SWEEP_INTERVAL_MS=5000

# Transports nationaux — chiffrement AES-256-GCM des identifiants de canal
# (CompanyChannelConfig, utils/secret-crypto.ts). ICI, dans le fichier VERSIONNÉ, alors que
# .env.test.local (gitignored) porte les VRAIS identifiants PDP : `npm run start:test` ne charge QUE
# ce fichier (voir .env.example, section Redis, pour le piège NOAUTH déjà payé pour Redis) et la spec Cypress
# 31 connecte le canal PDP avec des identifiants FICTIFS par l'API contre CE backend — sans cette clé
# ici, isEncryptionAvailable() serait faux et toute tentative de connexion échouerait en 503 avant
# même d'atteindre le serveur PDP fictif que la spec vise. Une clé de chiffrement d'une base de test
# JETABLE (invoicerr_db, tronquée à chaque run) n'est pas un secret de production : elle ne protège
# aucune donnée réelle, seulement le chiffrement AU REPOS d'identifiants de test dans une base de
# développement locale — la reproduire ici est donc sans risque, contrairement aux vrais
# PDP_CLIENT_ID/PDP_CLIENT_SECRET qui, eux, restent exclusivement dans .env.test.local.
CREDENTIALS_ENCRYPTION_KEY=e2896d60a5fe20415931030ea7eadb3352f2698948ba29948a9f2e04b8840e6d

# Cross-border VAT validation — swaps `ClientsModule`'s VAT validation client for
# `FakeSyntaxOnlyVatValidationClient` (documents/tax/vat-validation.ts) instead of the ordinary
# NODE_ENV=test null one: still ZERO network calls (never the real VIES — "a CI job must never
# depend on... VIES being up" stays true), but it answers VALID for a syntactically-valid VAT
# number, which is what makes the VALID -> B2B/reverse-charge transition observable through a real
# browser (Cypress spec 35 — FR->DE B2B with a valid German VAT number). See
# `clients.module.ts`'s own header for the full reasoning.
VAT_VALIDATION_FAKE=1

# e2e ONLY — laisse la suite 42-webhooks pointer un webhook vers son récepteur local (localhost).
# JAMAIS en production : la garde SSRF (webhook-url-guard.ts) est sinon pleinement active.
ALLOW_PRIVATE_WEBHOOK_URLS=1

# e2e ONLY — même garde que ci-dessus (@/utils/outbound-url.ts), partagée par le SSO par société, le
# client PDP et le client SdI : laisse 31-national-channels/74-received-invoice-inbound pointer PDP/SdI
# vers un serveur local (closed port ou vrai stub http) et 55-sso-settings enregistrer une URL OIDC de
# fixture (`*.example`, jamais résolue en DNS par construction RFC 2606). JAMAIS en production.
ALLOW_PRIVATE_OUTBOUND_URLS=1
