/// One row per received supplier invoice document.
/// Dedup key: (channel, externalId) — the authority-assigned document reference.

// ======= START OF INSTANCE FILE BACKUP ======= //
// backend/src/modules/backup. NOT a database backup (Postgres has its own, run separately) — this
// table only tracks runs of the periodic sweep that copies every document-related file on this
// instance (legal archives, received-invoice/attachment/logo uploads) to a secondary, dedicated S3
// bucket. Additive only. One row per sweep, created RUNNING and updated in place as the run
// progresses, so GET /api/backup/status always has something to read even for a run still in flight.

enum BackupRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model BackupRun {
  id         String          @id @default(cuid())
  status     BackupRunStatus @default(RUNNING)
  startedAt  DateTime        @default(now())
  finishedAt DateTime?

  // Every file the sweep considered this run, however it was handled — see backup-runner.ts's own
  // header for why an existing, same-size object at the destination key counts as "skipped" rather
  // than re-uploaded: every source path here is already content-hash-addressed, so a matching key is
  // proof enough of identical bytes without re-reading them.
  filesScanned  Int @default(0)
  filesUploaded Int @default(0)
  filesSkipped  Int @default(0)
  filesFailed   Int @default(0)

  // Bytes actually WRITTEN to the backup bucket this run (uploaded files only, never skipped ones) —
  // BigInt, not Int: a large instance's cumulative archive can exceed Postgres' plain Int ceiling
  // (2^31 bytes, ~2 GiB) well within one deployment's lifetime.
  bytesUploaded BigInt @default(0)

  // One `{ key, message }` entry per file that failed to copy — never the file's own bytes. A failed
  // file must never abort the run (backup-runner.ts's own header), so this accumulates across the
  // whole sweep. Never returned as-is by GET /api/backup/status: any company's OWNER can reach that
  // route, and a key here embeds another tenant's companyId/documentId (backup-status.service.ts's
  // own header) — this column stays for whoever has direct database access.
  errors Json @default("[]")

  @@index([startedAt])
}

// ======= END OF INSTANCE FILE BACKUP ======= //
