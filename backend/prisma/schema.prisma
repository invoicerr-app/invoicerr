// The SYSTEM emails — the two this application sends that are not about a document at all. Both are
// composed by the shared template engine (documents/actions/email-template.ts) from the copy shipped
// in backend/src/mail/system-email-templates.ts; a MailTemplate row is only ever a company's OVERRIDE
// of that copy.
//
// INVOICE, PAYMENT and RECEIPT were removed (20260912103000_unify_email_templates): rows of those
// three families were seeded for every company and read by NOTHING — a document's email comes from
// its own descriptor default or from `Company.documentEmailTemplates`, keyed by document type rather
// than by a closed enum, which is the only keying a pluggable type registry can work with (see
// documents/actions/company-email-templates.ts). Adding a member here would mean a new SYSTEM email,
// never a new document type.
enum MailTemplateType {
  SIGNATURE_REQUEST
  VERIFICATION_CODE
}

// Quote status
enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  EXPIRED
  REJECTED
}

// Invoice status — single vocabulary, maps onto ComplianceStatus where possible
enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  UNPAID
  OVERDUE
  SENT
  ARCHIVED
  PENDING_CLEARANCE // ~ placeholder for clearance countries (PART X)
  CLEARED // ~ placeholder for clearance countries (PART X)
  REJECTED // F-008: authority rejected it (KSeF, SdI scarto, PDP). Terminal.
  REFUSED // F-008: the BUYER declined a correctly transmitted invoice. Exits via CORRECT.
  TRANSMISSION_FAILED // F-008: never reached the authority. Retryable — the projection clears it.
  // All three are projected from ComplianceDocument.status by ApplySignalService
  // and are never set by a user action.
  CANCELLED
  CORRECTED
}

// Recurrence frequency
enum RecurrenceFrequency {
  WEEKLY // Every week
  BIWEEKLY // Every 2 weeks
  MONTHLY // Every month
  BIMONTHLY // Every 2 months
  QUARTERLY // Every 3 months
  QUADMONTHLY // Every 4 months
  SEMIANNUALLY // Every 6 months
  ANNUALLY // Every year
}

// Client type
enum ClientType {
  INDIVIDUAL
  COMPANY
}

// B2G routing (documents/b2g-routing/) — GOVERNMENT changes which channel/format an invoice to this
// client MUST use, per its own COUNTRY (see B2gRoutingRule below); BUSINESS (the default) leaves
// every existing transport/mandate mechanism untouched. Uppercase, same convention as ClientType
// right above — never a bare string, so a typo in a future caller fails to compile rather than
// silently matching nothing.
enum ClientKind {
  BUSINESS
  GOVERNMENT
}

// Document kind for Invoice (EN 16931 document taxonomy)
enum DocumentKind {
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
  CORRECTIVE_INVOICE
  PROFORMA
  DEPOSIT
  FINAL
}

// Item type (used for quote/invoice/recurring items)
enum ItemType {
  HOUR
  DAY
  DEPOSIT
  SERVICE
  PRODUCT
}

// Payment method types
// Role of a user within a company (multi-tenancy)
enum CompanyRole {
  OWNER
  ADMIN
  MEMBER
}

// PDF Configuration
model Company {
  id           String   @id @default(cuid())
  name         String
  description  String?
  currency     Currency @default(EUR)
  foundedAt    DateTime
  exemptVat    Boolean  @default(false)

  // Where this seller's intra-Community DISTANCE SALES to consumers are taxed — "ORIGIN" (this
  // company's own country) or "DESTINATION" (the buyer's). NULL, the state every company was in
  // before this column existed, means "never declared", and that is deliberately NOT a default the
  // product picks for them: Directive 2006/112/EC art. 33(a) taxes such a sale in the buyer's member
  // state, art. 59c(1) disapplies that below EUR 10 000 of EU-wide distance sales per calendar year
  // (leaving art. 32, i.e. this company's own country), and art. 59c(3) lets a seller under the
  // threshold opt into destination taxation anyway for two calendar years. The threshold is a running
  // total across EVERY member state and every sale the business makes — including sales this instance
  // has never seen — so no query over this database can establish it, and the option is a legal act
  // only the seller can report. A company that has not declared gets a clear, named refusal when it
  // tries to send an invoice that actually depends on the answer (a cross-border B2C sale of goods
  // inside the EU) — see documents/tax/resolve-invoice-tax.ts's own
  // `UndeclaredDistanceSalesRegimeError` — never a silently-applied guess. Same "no default,
  // deliberately" posture as `invoiceTransportId` below, for the same reason: a wrong guess here is
  // invisible on the invoice and wrong by several points of VAT.
  //
  // Plain `String?`, not a Prisma enum, for the same reason `referenceCurrency`/`invoiceTransportId`
  // are: it is read back through ONE narrowing parser
  // (documents/tax/resolve-invoice-tax.ts#parseDistanceSalesRegime), which already treats anything
  // that is not exactly one of the two values as "not declared" — the enum would buy a second,
  // migration-bound source of truth for a set that is closed by the Directive, not by us.
  distanceSalesRegime String?
  address      String
  addressLine2 String? // Second line for address (apartment, suite, etc.)
  postalCode   String
  city         String
  state        String? // State/Province (for US addresses, etc.)
  country      String
  countryCode  String? // ISO 3166-1 alpha-2, explicit override; falls back to guessCountryCode(country)
  // Per-recipient document language ("langue du document par destinataire") — the FALLBACK layer only: a
  // client with no `Client.language` of its own renders in this language rather than jumping straight
  // to English. Free-text, like `country` above, never a Prisma enum — see
  // documents/rendering/language/supported-languages.ts for the validated set a render actually
  // recognizes; an unrecognized or absent value here just means the resolver falls through to 'en',
  // never a rejected write (the same "permissive storage, type-safe consumption" split `country`
  // already holds).
  language     String?
  phone        String
  email        String

  // Polar customer email for THIS company's own hosted-billing customer (option A, product decision
  // 2026-09-16: one Polar customer PER COMPANY, `external_id = company.id` — see
  // `modules/billing/billing-customer.ts`'s own header). Polar requires a customer's email to be
  // unique within the organization; `email` above is reused by default, but two companies sharing one
  // contact address (a single owner's several companies, e.g.) would collide on the SECOND company's
  // first checkout — this optional override is what a company sets to pick its own distinct billing
  // address instead of changing its real contact `email`. `null` (the default) means "use `email`
  // above" — never defaulted to a synthetic address, the same "no fabricated value" discipline `iban`'s
  // own comment holds.
  billingEmail String?

  // BT-84 (Payment account identifier) — the seller's OWN receiving account, threaded into
  // `formats/semantic/build-semantic-invoice.ts` as `cac:PaymentMeans/cac:PayeeFinancialAccount`
  // (BG-16/BG-17) whenever set. Optional, and never invented: XRechnung's BR-DE-1 (a PAYMENT
  // INSTRUCTIONS group is mandatory) is exactly what this column exists to satisfy honestly — a
  // company with none on file gets a NAMED refusal citing BR-DE-1 and this field, never a fabricated
  // value (see formats/xrechnung-provider.ts's own header). Free `String`, not validated against the
  // ISO 13616 checksum here — the vendored XRechnung Schematron itself already checks that
  // (BR-DE-19, non-blocking) the moment a document is actually built; duplicating that check on
  // write would be a second, divergent copy of the same rule.
  iban String?

  // BT-86-adjacent (Payment service provider identifier) — the SWIFT/BIC code that pairs with `iban`
  // above. Written ONLY through `payment-methods/`'s "bank_transfer" method (never through
  // `EditCompanyDto`/`editCompanyInfo`, unlike `iban` — see that module's own header on why the two
  // fields share a home but not a write path): this column did not exist before this feature, so
  // there is no pre-existing settings screen whose behavior a second write path would have to stay
  // compatible with. Free `String`, same reasoning as `iban`'s own comment — not checksum-validated
  // here. NOT threaded into `rendering/sepa-qr.ts` (EPC069-12 v002's own field 5 stays deliberately
  // empty — see that file's header on why v002 was chosen specifically to avoid needing a BIC at
  // all) or into the semantic XML builder — both are a separate, unrequested piece of work; this
  // column exists to satisfy `payment-methods/bank-transfer.descriptor.ts`'s own presentation only.
  bic String?

  // DEAD COLUMNS, kept but never written any more (deliberately not dropped — that is a separate,
  // irreversible step). They belonged to a Prisma query extension removed on this branch (see
  // prisma.service.ts's own comment, and the `avant-refonte-documents` git tag); nothing has read
  // them since, and as of the `20260913120000_migrate_legacy_number_formats` migration nothing writes
  // them either (`EditCompanyDto` no longer declares them, so `company.service.ts#editCompanyInfo`'s
  // allow-list cannot resurrect them). That one-time migration copied each company's last value here
  // into `numberFormats` below, keyed `quote`/`invoice`, ONLY where `numberFormats` had no entry for
  // that key yet — see its own header for why "payment" was deliberately NOT migrated (no
  // DocumentTypeDescriptor by that id exists to read it).
  quoteStartingNumber   Int    @default(1)
  quoteNumberFormat     String @default("Q-{year}-{number:4}")
  invoiceStartingNumber Int    @default(1)
  invoiceNumberFormat   String @default("INV-{year}-{number:4}")
  paymentStartingNumber Int    @default(1)
  paymentNumberFormat   String @default("PAY-{year}-{number:4}")

  invoicePDFFormat String @default("facturx") // Ex: 'pdf' | 'facturx' | 'zugferd' | 'xrechnung' | 'ubl' | 'cii'

  // Chantier B ("branding", 2026-09-15 product decision) — the PDF stays a
  // FIXED document (no user-editable HTML/Handlebars, ever); what personalizes it is exactly these
  // THREE brand fields, applied by `documents/rendering/render-html.ts` as CSS over the one hardcoded
  // layout. Every field is independently NULLable, and NULL is the state every existing company was
  // already in before this migration — `render-html.ts` renders the exact pre-branding default for
  // each one absent (see that file's own `DEFAULT_ACCENT_COLOR`/`DEFAULT_BODY_FONT_STACK`), so a
  // company that never opens the Branding settings screen gets byte-for-byte the same PDF it always
  // got, forever, not merely on the day of this migration.
  //
  // `brandingLogoId` — the uploaded logo's own SHA-256 (`documents/rendering/branding/
  // logo-storage.ts#uploadLogo`), content-addressed and company-scoped the SAME way
  // `attachments/attachments.service.ts` already stores a receipt — see that file's own header for
  // why this is ONE column (the mime is recovered by trying the three allowed image extensions on
  // read, never a second nullable column that could drift out of sync with this one).
  brandingLogoId      String?
  // Hex `#rrggbb`, validated by `company/branding/branding.service.ts` BEFORE it is ever written here
  // — never a CSS/Tailwind token or a named color, so `render-html.ts` can drop it straight into an
  // inline style with no lookup table.
  brandingAccentColor String?
  // A KEY into the CLOSED, embedded font set (`documents/rendering/branding/font-catalog.ts`) —
  // deliberately never a raw CSS `font-family` string a caller could point at an arbitrary,
  // unlicensed webfont. An unrecognized value here (a stale key from a since-shrunk catalog) is
  // treated by the renderer exactly like NULL — never a broken `font-family` declaration.
  brandingFont        String?
  // The last NAMED preset (`documents/rendering/branding/presets.ts`) the company explicitly picked —
  // a label of where `brandingAccentColor`/`brandingFont` started from, never a LIVE binding: picking
  // "Modern" and then hand-adjusting the accent color does NOT clear this back to null (see
  // `branding.service.ts#setBranding`'s own header). NULL means "no preset ever chosen" — either no
  // branding at all, or colour/font set by hand without ever picking a named starting point.
  brandingPreset      String?

  // Per-document-type number FORMAT, keyed by DocumentTypeDescriptor.id — e.g.
  // `{ "invoice": "FAC-{year}-{number:5}" }`. A type absent here falls back to
  // documents/numbering/format-number.ts's own `defaultNumberFormatFor(typeId)` — never a hole in the
  // format, only in WHO chose it. Written through `PUT /api/company/number-format`
  // (`CompanyService#updateNumberFormat`, the only path that runs `assertValidNumberPattern`) — by the
  // Portuguese ATCUD settings screen and, since the migration above, by the main "Number formats" card
  // too, one type at a time. Never through `POST /api/company/info`'s `EditCompanyDto`: see
  // `editCompanyInfo`'s own comment for why that write path allow-lists its columns instead of
  // spreading the request body.
  numberFormats Json?

  // Which registered payment provider (documents/payments/payment-provider-registry.ts) an invoice's
  // "Pay" link in the client portal opens a checkout session against — "stripe" | "mollie" | "paypal".
  // UNLIKE invoiceTransportId right below, this one DOES fall back silently when unset (never a loud
  // block) — `payments/payment-sessions.service.ts`'s own DEFAULT_PROVIDER_ID resolves a null/empty
  // value to "stripe", the sole hardcoded provider this app had before Mollie/PayPal existed
  // (2026-09-15): a company that connected Stripe under the OLD hardcoded-only system and never
  // touches this new setting must keep working exactly as before, not silently lose its payment
  // provider the day this column ships with every existing row NULL. Read+written the SAME allow-
  // listed way as invoiceTransportId (EditCompanyDto, company.service.ts#editCompanyInfo) — but from
  // its own small selector on the Payments settings screen (payments.settings.tsx), never the big
  // company-info form, since the two settings screens are otherwise unrelated concepts.
  paymentProviderId String?

  // Which registered document transport (documents/transports/transport-registry.ts) an invoice's
  // "send" action delivers through — e.g. "email". No default, deliberately: a company that has
  // never chosen one gets a clear, loud block when it tries to send an invoice (see
  // documents/actions/invoice-actions.ts), not a silent fallback to any particular channel. Never a
  // country/jurisdiction column — the choice belongs to the company, not to where it is.
  invoiceTransportId String?

  // Per-document-type EMAIL template override, keyed by DocumentTypeDescriptor.id — e.g.
  // `{ "invoice": { "subject": "...", "body": "..." } }` (documents/descriptors/types.ts's own
  // `DocumentEmailTemplate` shape). Same pattern as `numberFormats` right above: a type absent here
  // falls back to that type's OWN descriptor default (documents/actions/email-template.ts's
  // `resolveEmailTemplate`), never a hole. An entry may carry an optional `html` part alongside `body`
  // (the text one) — `{ "invoice": { "subject": "...", "body": "...", "html": "<p>...</p>" } }`; every
  // value stored before that was possible stays valid, since `html` is optional. Stored html is
  // sanitized on the way IN (mail/sanitize-email-html.ts), never merely on the way to a screen.
  //
  // Deliberately NOT `MailTemplate`/`emailTemplates` below: that table is keyed by the CLOSED
  // `MailTemplateType` enum (the two SYSTEM emails), so a third-party document type could never gain a
  // template there without a migration — see documents/actions/company-email-templates.ts's own header
  // for which storage answers which keying problem. Both go through the SAME interpolation engine.
  documentEmailTemplates Json?

  dateFormat String @default("dd/MM/yyyy") // Date format for quotes and invoices

  // Multi-currency consolidation. Null — the default, and the only state every
  // company was already in before this column existed — means NO consolidation happens anywhere:
  // every dashboard/statistics aggregate stays grouped BY CURRENCY, exactly as
  // contributions/expense-contributions.ts and invoice-contributions.ts already do. Setting this is
  // an opt-in, never a migration a company is silently enrolled into.
  //
  // Plain `String?`, not the `Currency` enum `currency` above uses: a currency flowing through the
  // document layer is already treated as a bare string everywhere that matters (compute-totals.ts's
  // currency detection, DocumentPayment.currency, credit-note settlement) — the `Currency` enum is a
  // presentation convenience for ONE dropdown (CurrencySelect), not a second source of truth this
  // column needs to satisfy too. See CurrencyRate.from/to's own comment for the same choice.
  referenceCurrency String?

  // Automatic reminders ("relances automatiques") — OPT-IN, default `false`: auto-emailing a
  // company's own CLIENTS is side-effectful in a way none of this module's other background sweeps
  // are (the conformity/currency-rate sweeps only ever touch this company's own rows) — a company
  // that never asked for it must never have a client suddenly receive a dunning email the day this
  // migration lands. `reminders/reminder-sweep-runner.ts`'s own sweep queries exactly this flag; a
  // company left at the default is invisible to it, not merely "not yet due" for one.
  remindersEnabled Boolean @default(false)

  // Internal approval workflow above a threshold ("workflow d'approbation interne au-delà d'un seuil") — the QUICK-WIN
  // scope: a ROLE+VALUE GATE on the "send" action, not a full request→approve state machine with its
  // own pending-approval records (that remains a future extension — see
  // documents/approval/approval-gate.ts's own header). NULL — the default, and the only state every
  // existing company was already in before this column existed — means "no approval required, ever":
  // a MEMBER can send any document regardless of amount. A value is a MINOR-units amount in the
  // DOCUMENT's OWN currency (never currency-converted — see approval-gate.ts for that caveat); a
  // MEMBER trying to send a document whose gross total exceeds it is refused, while an ADMIN/OWNER
  // sending it IS the approval (there is deliberately no separate "approve" action or actor to record).
  approvalThresholdMinor Int?

  // Self-service full data export (`POST /api/companies/export`, `companies.service.ts#exportCompanyData`)
  // — the data-portability right lets a company pull everything it holds on its own, without writing to
  // support first, and this stamps the last time it actually did. `null` means "never" (every existing
  // company before this column existed, and any company that has not asked yet). The ONLY reader is the
  // route's own cooldown check — a CAS `updateMany` claims the slot atomically before the expensive
  // Chromium-per-document build even starts, so two racing requests can never both build at once.
  lastSelfServiceExportAt DateTime?

  createdAt               DateTime                     @default(now())
  emailTemplates          MailTemplate[]
  webhooks                Webhook[]
  Article                 Article[]
  partyIdentifiers        PartyIdentifier[]
  Client                  Client[]
  members                 UserCompany[]
  apiKeys                 ApiKey[]
  invitationCodes         InvitationCode[]
  documents               DocumentInstance[]
  documentSchedules       DocumentSchedule[]
  documentNumberSequences DocumentNumberSequence[]
  documentPayments        DocumentPayment[]
  documentArchives        DocumentArchive[]
  documentAuthorityEvents DocumentAuthorityEvent[]
  documentDownloadTokens  DocumentDownloadToken[]
  documentReminders       DocumentReminder[]
  currencyRates           CurrencyRate[]
  channelConfigs          CompanyChannelConfig[]
  signingCertificates     CompanySigningCertificate[]
  atcudSeries             CompanyAtcudSeries[]
  signatures              Signature[]
  dangerOtp               DangerOtp?
  clientPortalTokens      ClientPortalToken[]
  ssoProvider             CompanySsoProvider?
  // Time tracking & project invoicing — see Project/TimeEntry below.
  projects                Project[]
  timeEntries             TimeEntry[]
  // Bank reconciliation ("rapprochement bancaire") — see BankStatement/BankStatementLine below.
  bankStatements          BankStatement[]
  bankStatementLines      BankStatementLine[]
  // Online payment ("paiement en ligne") — see PaymentCheckoutSession below.
  paymentCheckoutSessions PaymentCheckoutSession[]
  // See CompanyPaymentMethodConfig below.
  paymentMethodConfigs    CompanyPaymentMethodConfig[]
  // Custom fields ("champs personnalisés") — see CompanyCustomField below.
  customFieldDefinitions  CompanyCustomField[]
  // Enriched expense categories ("notes de frais enrichies") — see ExpenseCategory below. Product
  // decision 2026-09-15: expense categories are per-company DATA, not the fixed catalog
  // expense.descriptor.ts used to hardcode (see that file's own current header).
  expenseCategories       ExpenseCategory[]
  // Hosted-billing offer (product decision 2026-09-15, `backend/src/modules/billing/`) — see
  // CompanySubscription below. Optional: the row is created LAZILY, on first need, by
  // `billing/company-subscription.store.ts#getOrCreateCompanySubscription` — never by a migration
  // backfill, and never for a self-hosted instance that has not set
  // `WARNING__ENABLE_BILLING_FOR_USERS__WARNING`, which is what keeps an existing company from ever
  // being retroactively enrolled the day that flag first flips to true (see that store's own header).
  subscription            CompanySubscription?
  // Ownership transfer requests targeting this company (product decision 2026-09-17,
  // `modules/company/transfer/`) — see CompanyOwnershipTransfer below for the full state machine.
  ownershipTransfers      CompanyOwnershipTransfer[]
}

// Hosted-billing offer (product decision 2026-09-15) — ONE row per company, created lazily. See
// `backend/src/modules/billing/lifecycle.ts`'s own header for the full two-cycle state machine this
// drives (never-paid trial→blocked→zipped→deleted, vs paid-then-stopped active→past_due→blocked→
// zipped→deleted) — this model only stores the FACTS that machine reads; every transition decision
// itself lives in that pure module, never duplicated here.
model CompanySubscription {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  status CompanySubscriptionStatus @default(TRIAL)

  // The 14-day trial window, stamped once at lazy creation (`computeTrialWindow`, lifecycle.ts) and
  // NEVER recomputed afterward — a company that later becomes ACTIVE (paid) or BLOCKED keeps its
  // original trial dates as a historical fact, even though `lifecycle.ts` stops reading them once
  // `status` has moved past TRIAL.
  trialStartedAt DateTime
  trialEndsAt    DateTime

  // Set the moment `status` becomes BLOCKED (from TRIAL's own 14 days, or from PAST_DUE with no
  // window of its own — see lifecycle.ts's header) — the anchor `lifecycle.ts#computeLifecycleTransition`
  // adds BLOCKED_DAYS (14) to.
  blockedAt     DateTime?
  // Set the moment the zip export is actually mailed to the OWNER (`export-zip.ts`) — the DAY this
  // stamps, never the day BLOCKED was entered, is what a human auditing this row would want to see
  // "how long ago did we warn them" against.
  zipSentAt     DateTime?
  // When the real, cascading deletion (`deletion.ts`) may run — computed once, when `zipSentAt` is
  // stamped: `zipSentAt + 30 days` (never-paid — the statutory floor, `lifecycle.ts#MIN_RETRIEVAL_DAYS`)
  // or `zipSentAt + 180 days` (this company once had a real `polarSubscriptionId` — see lifecycle.ts's
  // header for why that field alone is what distinguishes the two cycles here, with no separate boolean).
  deletionDueAt DateTime?

  // Polar's own ids for this company's paying customer/subscription — `null` until a checkout
  // actually completes (`webhook-handlers.ts`). `polarSubscriptionId` is NEVER cleared once set, even
  // once the subscription is later canceled/revoked — see lifecycle.ts's own header for why that
  // permanence is exactly what makes it usable as the never-paid/paid-then-stopped discriminator.
  polarCustomerId     String?
  polarSubscriptionId String?

  // Polar's own `Subscription.currentPeriodEnd` — the end of the period THIS COMPANY HAS ALREADY PAID
  // FOR, mirrored verbatim from every subscription webhook/reconcile read that carries one
  // (`webhook-handlers.ts#applySubscriptionWebhook`, `status-reconcile.ts`), the same "leave it alone
  // when the fact set omits it" convention `interval`/`seats` already hold. `null` until the first such
  // fact arrives (a Company still in TRIAL has no Polar subscription to read one from at all).
  //
  // The ONE reason this column exists: `paid-period-grace.ts`'s Terms-of-Service Section 20.2
  // exception — a Company with a subscription period already in progress when the Terms change keeps
  // full write access, under the version it paid for, until the later of a calendar floor or this exact
  // date. Never cleared on its own when `status` moves away from `ACTIVE` (a stale value combined with
  // a non-ACTIVE status can never grant that exception — `paid-period-grace.ts`'s own header — so there
  // is nothing to protect by clearing it defensively).
  currentPeriodEnd DateTime?

  // The PURCHASED seat quantity. Invoicerr never tells Polar how many seats to bill — it only reads
  // what Polar says: the quantity is bought in the Polar portal itself and arrives here EXCLUSIVELY via
  // `webhook-handlers.ts` (a `subscription.*` webhook's own `seats` field) and `seat-reconcile.ts`'s
  // opportunistic SDK read-and-store retry; `seat-sync.ts` never calls `subscriptions.update` with a
  // seat count (`seat-sync.spec.ts`'s own no-write guard). Defaults to 1 — the ONE seat every plan
  // includes, and also what a company still in TRIAL (no Polar subscription to read from at all) has.
  //
  // Capacity vs. headcount are two different numbers now: this column is what was BOUGHT,
  // `UserCompany` row count is who actually joined. `seat-sync.ts#withSeatReservation` refuses a new
  // membership once headcount reaches this number (`NoFreeSeatError`); `seat-holders.ts#seatHolders`
  // decides who among existing members keeps access if a later drop in this number (the OWNER lowering
  // it in the Polar portal) puts the company OVER capacity — the most recently arrived non-OWNER
  // members wait, never the OWNER.
  seats Int @default(1)

  // The billing cadence Polar reports for the active product (`webhook-handlers.ts`) — `null` until a
  // real subscription exists (TRIAL has no interval of its own). The price/plan itself is never
  // stored here — see this model's own header: Polar owns the pricing grid, this only mirrors WHICH
  // of the two configured products (`POLAR_PRODUCT_ID_MONTHLY`/`POLAR_PRODUCT_ID_YEARLY`) is active.
  interval CompanySubscriptionInterval?

  // Stamped by `seat-sync.ts` when a seat INCREASE's immediate-proration charge is refused by Polar
  // (a declined card) — the ONE fact `billing-status-view.ts` needs to tell "your card failed to pay
  // for a seat you just added" apart from every other reason a subscription can be PAST_DUE. Cleared
  // the moment `webhook-handlers.ts` next reports ACTIVE (the same reset `blockedAt`/`zipSentAt`/
  // `deletionDueAt` already get) — a stale reason must never survive the company paying again.
  seatPaymentFailedAt DateTime?

  // Stamped by `company/company.service.ts#editCompanyInfo` when pushing the company's new name/email
  // to its Polar customer fails — `billing-lifecycle-sweep-runner.ts` retries the push on every tick
  // while this is set, and clears it once the retry succeeds. `null` is the normal state (nothing to
  // retry), not "never synced" — a company with no Polar customer at all is simply skipped by both
  // the push and the retry (see `billing-customer.ts`'s own header: the customer is created lazily, at
  // first checkout, never before).
  customerSyncFailedAt DateTime?

  // Stamped by `checkout-session.ts` the moment a checkout session is actually created — the "is a
  // checkout already in flight for this company" signal `createCheckoutSession` refuses a SECOND
  // concurrent checkout against, for a company with no active/trialing subscription yet (see that
  // file's own header for the exact window).
  lastCheckoutStartedAt DateTime?

  // The timestamp of the last Polar-side FACT actually applied to this row — either the delivering
  // webhook's own `webhook-timestamp` header, or, for a `status-reconcile.ts` repair read, the
  // reconciled subscription's own `modifiedAt`. `applySubscriptionWebhook` compares an incoming fact's
  // timestamp against this before overwriting `status`/`interval` — an OLDER fact (a reconcile read
  // that raced a webhook already applied) is logged and dropped rather than clobbering a fresher
  // state with a stale one. `null` for a subscription no fact has ever been timestamped against yet
  // (every fact applied before this column existed) — treated as "apply unconditionally", the same
  // permissive default `interval`'s own null-means-leave-alone convention already holds.
  lastPolarFactAt DateTime?

  // Which BLOCKED-window (J-7/J-1 before the zip) and ZIPPED-window (J-7/J-1 before the permanent
  // deletion) OWNER warning emails have already gone out for this subscription — see
  // `billing-lifecycle-sweep-runner.ts`'s own header for the milestone keys. A plain string array
  // rather than four booleans/a separate table: milestones are looked up by membership
  // (`milestone in sub.billingWarningMilestonesSent`), never joined against, and the set never shrinks
  // — an `@default([])` array is the simplest additive column that is still trivially idempotent (the
  // sweep only ever APPENDS a milestone once, checked before sending).
  billingWarningMilestonesSent String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("company_subscription")
}

// Dedup ledger for `POST /api/billing/webhooks/polar` — one row per Polar delivery, keyed by that
// delivery's own `webhook-id` header (a stable id Polar reuses verbatim on every RETRY of the SAME
// delivery, per Standard Webhooks — never a UUID this app mints itself). `polar-webhook.controller.ts`
// inserts a row BEFORE dispatching to a handler; a unique-constraint violation on that insert is a
// replay (a provider retry, or Polar's own dashboard "resend"), answered 200 immediately without
// re-running `handleSubscriptionPayload` a second time — the ONE case the type-of-write-based
// idempotency `webhook-handlers.ts`'s own header used to rely on cannot cover on its own: two
// deliveries racing each other concurrently, where "the write is naturally idempotent" is true of the
// FINAL state but does not stop a handler from actually running twice.
model PolarWebhookEvent {
  id         String   @id
  receivedAt DateTime @default(now())

  @@map("polar_webhook_event")
}

enum CompanySubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  BLOCKED
  ZIPPED
  DELETED
}

enum CompanySubscriptionInterval {
  MONTH
  YEAR
}

// Manually entered exchange rates. The rule that governs
// every USE of this table (contributions/currency-consolidation.ts): a conversion is INFORMATION,
// never a replacement — the document's own amount and currency stay the truth, and a consolidated
// aggregate built from a row here always carries the rate, its `asOf` date, and its `source`
// alongside the converted number, never a bare converted figure.
//
// `source` is `"manual"` for now — there is no external exchange-rate API call anywhere in this
// codebase, deliberately: that would be a network dependency in production and a vendor choice this
// task does not make. The column exists so a future automated feed can identify itself without a
// schema change; not a closed enum, since there is only one value implemented today.
//
// No inverse rate is ever derived (1/rate) from a stored one — that would introduce a silent
// rounding error nobody asked for. A company wanting both EUR→USD and USD→EUR enters both rows; see
// currency-rates/convert.ts's own `resolveLatestRate` for the exact-pair-only lookup this implies.
//
// Company-scoped, unlike the pre-refonte `CurrencyConversion` table (git tag
// `avant-refonte-documents`): that one was global (no companyId), had no `asOf` or `source`, stored
// `rate` as a `Float`, and carried an `expiresAt` TTL implying an external-API cache. None of that
// carries over — a rate here is a fact ONE company entered, at a point in time, from a source it can
// name, and it never expires on its own: a company wanting a fresher rate enters a new row with a
// later `asOf`, which simply outranks the old one at resolution time (most recent `asOf <= now`).
model CurrencyRate {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  // Bare strings, not the `Currency` enum — see Company.referenceCurrency's own comment.
  from String
  to   String

  // How many units of `to` one unit of `from` is worth. Decimal, not Float: a rate multiplies every
  // converted amount, so a Float's binary rounding would compound into visibly wrong money the more
  // it's used — the same reason every `amountMinor` column elsewhere is an integer, never a float.
  rate Decimal

  // When this rate was true — NOT when it was entered (`createdAt` already records that).
  // Resolution (convert.ts's `resolveLatestRate`) takes the most recent row with `asOf <= now` for
  // the exact (from, to) pair; a future-dated `asOf` is simply not eligible yet.
  asOf DateTime

  source String @default("manual")

  createdAt DateTime @default(now())

  @@index([companyId, from, to, asOf])
}

// Join table linking users to the companies they belong to, with a role
model UserCompany {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      CompanyRole @default(MEMBER)
  createdAt DateTime    @default(now())

  // A numbered desk on the company's own generative "Settings > Seats" office plan — assigned to the
  // first free integer (`seat-sync.ts#withSeatReservation`)
  // the moment this row is created (company creation, invitation acceptance, SSO auto-provisioning),
  // moved freely between free desks by an OWNER/ADMIN (`seats-view.ts#moveMemberSeat`). Purely
  // cosmetic/organizational — NEVER read for capacity or billing decisions (`seat-holders.ts#seatHolders`
  // decides who actually has access from role + `createdAt` alone, deliberately ignoring this column, so
  // reassigning a desk can never itself grant or revoke access). Nullable: `null` for a row created
  // before this column existed, backfilled lazily on the first `GET /api/billing/seats`
  // (`seats-view.ts#ensureSeatIndexesAssigned`) rather than by a data migration.
  seatIndex Int?

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("user_company")
}

// Client model
model Client {
  id               String            @id @default(cuid())
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId        String
  name             String
  description      String?
  foundedAt        DateTime? // Date when the client company was founded
  contactFirstname String?
  contactLastname  String?
  contactEmail     String?
  contactPhone     String?
  address          String
  addressLine2     String? // Second line for address (apartment, suite, etc.)
  postalCode       String
  city             String
  state            String? // State/Province (for US addresses, etc.)
  country          String
  countryCode      String? // ISO 3166-1 alpha-2, explicit override; falls back to guessCountryCode(country)
  // Per-recipient document language ("langue du document par destinataire") — the ONE explicit,
  // authoritative source a recipient's PDF/email language is resolved from
  // (documents/rendering/language/resolve-recipient-language.ts). Deliberately NOT derived from
  // `country` above: a country names a jurisdiction, not a language (Belgium, Switzerland — a client
  // domiciled there speaks any one of several official languages, and guessing wrong would be worse
  // than the English default this field's own absence already falls back to). Free-text, like
  // `country`, never a Prisma enum — see `rendering/language/supported-languages.ts` for the validated
  // set a render actually recognizes; an unsupported or absent value here is never rejected at write
  // time, only never picked by the resolver, which falls through to `Company.language` and then 'en'.
  language         String?
  currency         Currency?
  type             ClientType        @default(COMPANY)
  // B2G routing — see ClientKind above and B2gRoutingRule below. Default BUSINESS: every existing
  // client, and every client created without touching this field, keeps today's behavior exactly —
  // no transport/mandate precedence change unless a client is explicitly marked GOVERNMENT.
  kind             ClientKind        @default(BUSINESS)
  // The received-invoice reconciliation's own "role", DELIBERATELY a separate
  // boolean rather than folded into `kind` above: `kind` (BUSINESS/GOVERNMENT) is a B2G ROUTING fact
  // (which channel/format an OUTBOUND invoice to this client must use), while "is this company's own
  // SUPPLIER" is an orthogonal fact about the INBOUND direction — a government body can perfectly well
  // be a supplier (buying office supplies from the town hall's own print shop is not fantasy), and a
  // supplier this company also happens to invoice back stays possible too. `kind` cannot carry both
  // without inventing composite values (BUSINESS_SUPPLIER, GOVERNMENT_SUPPLIER, …) for a fact that has
  // nothing to do with what `kind` already means — a plain, independent flag is the honest shape.
  // Default false: every EXISTING client, and every one created without touching this field, is not a
  // supplier (the backfill decision this migration encodes) — set true ONLY by the received-invoice
  // reconciliation flow (auto-match or a manual link, `received-invoices/supplier-reconciliation.ts`),
  // NEVER unset automatically afterwards (see that file's own header for why "one-way" is correct).
  isSupplier       Boolean           @default(false)
  salutation       String            @default("Mr") // Mr, Ms, Mrs (We need a default value for the invoice generation)
  sex              String            @default("other") // male, female, other (We need a default value for the invoice generation)
  title            String            @default("Doctor") // Doctor, Professor (We need a default value for the invoice generation)
  isActive         Boolean           @default(true)
  partyIdentifiers PartyIdentifier[]

  // The client portal (`client-portal/`) — see ClientPortalToken below. A client can have several
  // across its life (a fresh invite after the previous one expired/was revoked) — never overwritten,
  // the same "one row per grant, soft-revoked" posture DocumentDownloadToken/Signature already hold.
  portalTokens ClientPortalToken[]

  // Time tracking & project invoicing ("suivi du temps & facturation de projets") — see Project below. A
  // client can have several concurrent projects (an agency running two engagements for the same
  // client needs its hours kept apart), which is the whole reason Project exists as its own model
  // rather than TimeEntry hanging directly off Client — see project.service.ts's own header.
  projects Project[]

  // Custom fields ("champs personnalisés") — a company-defined, per-client value, keyed by
  // the OWNING `CompanyCustomField.key` (never prefixed here — unlike a DOCUMENT instance's own `data`,
  // this JSON blob is ALREADY an isolated namespace of its own, so no key here can ever collide with a
  // real `Client` column the way an unprefixed key could collide with a document type's native field
  // key — see `company-custom-fields/types.ts`'s `toFieldDescriptor` header for the document-side
  // prefix this same reasoning rules out needing). Absent/`{}` for every client with no company-defined
  // field filled in
  // yet — the routine case, not a migration gap. A definition being renamed or archived (soft-delete,
  // `CompanyCustomField.archivedAt`) never touches this column at all: the value stays keyed by the
  // definition's immutable `key`, exactly as entered.
  customFields Json?

  @@index([companyId])
}

// Per-country required identifiers (LEGAL_ID, VAT, RFC, CURP, REGON, …)
model PartyIdentifier {
  id        String   @id @default(cuid())
  scheme    String
  value     String
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // C4: the outcome of validating this identifier, and WHEN. NULL means never checked — distinct
  // from checked-and-invalid, a distinction both the engine and the user need.
  validationStatus String? // VALID | INVALID | UNAVAILABLE
  validatedAt      DateTime?
  validationSource String? // e.g. eu-vies

  @@unique([companyId, scheme])
  @@unique([clientId, scheme])
}

// One company's OVERRIDE of a shipped system email (see MailTemplateType). A company with no row for a
// family is a normal, fully functional state — the shipped default applies — never "unconfigured": the
// copy lives in code (src/mail/system-email-templates.ts), so nothing has to be seeded for a signature
// request or a verification code to be sendable, and improving the wording reaches every instance on
// upgrade instead of only the companies whose rows predate it.
model MailTemplate {
  id        String           @id @default(cuid())
  type      MailTemplateType
  subject   String
  // The HTML part — what this column has always held, and what the settings screen editing it writes.
  // The text/plain alternative is DERIVED from it at send time (email-template.ts's
  // `deriveTextFromHtml`), so a customised row gains a text part without its markup being touched.
  body      String
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  @@unique([companyId, type])
}

model Article {
  id                String   @id @default(cuid())
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId         String
  name              String // label shown in the picker
  description       String? // text injected into the line item
  type              ItemType @default(SERVICE)
  unitPrice         Float    @default(0)
  unitPriceMinor    Int?
  vatRate           Float    @default(0)
  isActive          Boolean  @default(true)
  // Basic stock management ("gestion de stock basique") — NULL means "not stock-tracked" (a SERVICE
  // article has no stock; only a GOODS/PRODUCT article opts in by having this set at all). Only a
  // non-null `quantity` is ever decremented (documents/stock/apply-stock-on-issuance.ts) or alerted on
  // (articles.service.ts's `isLowStock`) — deliberately NOT keyed off `type` itself, so a company that
  // DOES want to track a "SERVICE" line's stock (e.g. a limited course seat count) isn't blocked by a
  // type this schema never meant as a hard constraint, only a picker label.
  quantity          Int?
  // NULL means "no alert, ever" for this article — distinct from `0` (alert as soon as ANY stock is
  // gone). See `isLowStock`'s own doc comment (articles.service.ts) for the exact predicate.
  lowStockThreshold Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Time tracking & project invoicing ("suivi du temps & facturation de projets") — the layer TimeEntry hangs
// off. See project.service.ts's own header for why this is a THIRD model between Client and
// TimeEntry rather than either of the two cheaper shapes (entries straight on Client, or entries
// hanging off an existing quote): an agency running several concurrent engagements for the SAME
// client cannot separate their hours without one. Plain data, like Article — NOT a document type
// (descriptors/): a project is never issued, sent, numbered or archived, so it has no business going
// through DocumentsService/ActionRegistry at all.
model Project {
  id              String      @id @default(cuid())
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId       String
  client          Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId        String
  name            String
  description     String?
  // The rate a NEW entry logs against by default (minor units, this company's own currency — same
  // convention as Article.unitPriceMinor). NULL means "no default set yet"; an entry can still
  // override it with its own `hourlyRateMinor` (time-entries.service.ts) — see that column's own
  // comment for why the override lives on the entry rather than being forced to match the project.
  hourlyRateMinor Int?
  isArchived      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  timeEntries     TimeEntry[]

  @@index([companyId])
  @@index([clientId])
}

// One logged block of work against a Project. Never a document type (see Project's own comment) —
// what this table's rows eventually BECOME, once billed, is an ordinary invoice LINE
// (time-tracking/generate-invoice-lines.ts), built to look exactly like a hand-typed HOUR line so
// the tax engine and every format provider treat the two identically; nothing downstream of the
// invoice ever queries TimeEntry again.
model TimeEntry {
  id              String            @id @default(cuid())
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId       String
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  date            DateTime
  // Minutes, not a float hour count — avoids the repeating-decimal rounding a duration like "50
  // minutes" (0.8333... h) would otherwise force onto every reader of this column. Converted to
  // hours only once, at the very last moment (generate-invoice-lines.ts), for the invoice line's own
  // `quantity`.
  durationMinutes Int
  description     String?
  // Whether this entry should EVER be billed at all (an internal meeting, unpaid onboarding time) —
  // independent of `invoiceId`: a non-billable entry can never be selected for billing
  // (time-entries.service.ts's own `findUnbilled` filters on both), so it never even reaches the
  // "already billed?" question `invoiceId` answers.
  billable        Boolean           @default(true)
  // This ONE entry's own rate override (minor units) — NULL means "use the project's own
  // `hourlyRateMinor`". Separate column, not a write-through onto Project at entry-creation time:
  // a project's default rate can change later (a renegotiated contract) without silently rewriting
  // history for entries already logged at the old one, while a SPECIFIC entry (a rush job, a senior
  // consultant covering one day) can still bill at its own rate without that becoming the project's
  // new default for every other entry.
  hourlyRateMinor Int?
  // Which invoice this entry was billed into — NULL means unbilled. Set EXACTLY ONCE, atomically,
  // alongside that invoice's own creation (time-tracking/generate-invoice-lines.ts's
  // `billTimeEntriesToInvoice`): the same transaction that creates the DocumentInstance claims every
  // entry it consumes with a single `UPDATE ... WHERE invoiceId IS NULL`, so two concurrent requests
  // racing over the SAME entry can never both win (Postgres serializes the two UPDATEs on this row;
  // the loser's own WHERE clause matches zero rows once the winner commits — see that function's own
  // header for the full reasoning, the same one numbering/sequence.ts already documents for
  // `bumpSequence`). Never reset back to NULL by anything automatic once billed — except by the
  // invoice itself being deleted (`onDelete: SetNull` below), which is the one honest way a billed
  // entry becomes unbilled again.
  invoice         DocumentInstance? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([companyId])
  @@index([projectId])
  @@index([invoiceId])
}

// Signature model
enum PdfDocumentType {
  QUOTE
  INVOICE
}

// Short-lived, unauthenticated download link for a quote/invoice PDF — minted
// by the MCP PDF tools so a chat client (e.g. OpenWebUI) that can't render an
// embedded MCP resource block can still offer the user a clickable URL.

// `PluginType`/`Plugin` (in-app, DB-backed, Settings-configurable signing/storage providers) were
// removed 2026-09-17 — see `backend/prisma/migrations/20260917170000_remove_plugin_storage_system/
// migration.sql`'s own header for what they were and why the table is genuinely droppable (unlike an
// enum VALUE, a whole table+enum has no "cheap to leave inert" concern). Received-invoice OCR, the
// one extension point that used to share this enum's `OCR` member, never actually went through
// `Plugin` — see `backend/src/plugins/index.ts`'s own header.

enum WebhookEvent {
  // Document events (generic, 2026-09-03) — replaces the per-type
  // QUOTE_*/INVOICE_*/PAYMENT_*(document)/RECEIPT_*/SIGNATURE_*/PAYMENT_METHOD_*/PAYMENT_RECEIVED
  // families purged below: every one of those families was checked by grep against
  // `WebhookDispatcherService.dispatch(WebhookEvent.X, ...)` call sites across backend/src and NONE
  // had a real emitter — INVOICE_SENT/QUOTE_SENT were the only exceptions, and their one emitter
  // (actions/async-send.ts) is exactly what DOCUMENT_SENT below replaces it with. A future
  // document type (or a future write inside DocumentsService) gets every one of these five for
  // free — no migration, no per-type enum member ever again. CLIENT_*/COMPANY_* keep their own
  // dedicated events (real emitters: clients.service.ts, company.service.ts) — genuinely different
  // entities, not "documents", so they are deliberately NOT folded into this family.
  DOCUMENT_CREATED
  DOCUMENT_SENT
  DOCUMENT_SEND_FAILED
  DOCUMENT_AUTHORITY_EVENT
  DOCUMENT_DELETED
  // Fires the
  // instant a WRITE (a payment inserted, a credit note reaching "sent") makes a document's own
  // settlement (settlement/compute-settlement.ts) CROSS from "not settled" to "settled" — never on
  // an ordinary read/recompute of an already-settled document. See settlement/document-settled.ts's
  // own header for the two write paths that check for this crossing today.
  DOCUMENT_SETTLED
  // Fires the instant an invoice's own "cancel" action
  // (actions/invoice-actions.ts) actually commits "cancelled" to Postgres — a THIRD-PARTY
  // integration that already saw DOCUMENT_SENT for this invoice needs to know it is now void. See
  // that handler's own header for why this is a dedicated event, never folded into DOCUMENT_DELETED
  // (the row still exists) or a bare re-fire of DOCUMENT_SENT.
  DOCUMENT_CANCELLED
  // The hardened, reintroduced e-signature: fires the instant
  // the PUBLIC OTP-verification flow (documents/signatures/signatures.service.ts, never an
  // authenticated `runAction`) actually commits a document's own status to "signed". A member of the
  // generic DOCUMENT_* family, NEVER a resurrection of the purged SIGNATURE_* family (the document-
  // events comment above this enum lists SIGNATURE_* among the 51 values purged for having no real
  // emitter — this one has a real one, the same bar every surviving DOCUMENT_* member already met).
  DOCUMENT_SIGNED

  // Client events (2026-09-03) — of the six CLIENT_* members this enum used to
  // carry, grep against `WebhookDispatcherService.dispatch(WebhookEvent.X, ...)` call sites found a
  // real emitter in `clients.service.ts` for only these four. CLIENT_ACTIVATED/CLIENT_DEACTIVATED
  // purged: the client "isActive" toggle dispatches through the ordinary CLIENT_UPDATED, there never
  // was a dedicated activation/deactivation event to fire.
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_DELETED
  CLIENT_SEARCHED

  // Company events (2026-09-03) — same method, `company.service.ts` is the only
  // real emitter and dispatches exactly these three. COMPANY_PDF_CONFIG_UPDATED/COMPANY_INFO_VIEWED
  // purged: the PDF config write and the "view company info" read never dispatched a webhook, despite
  // the enum members existing since the very first webhook module.
  COMPANY_CREATED
  COMPANY_UPDATED
  COMPANY_EMAIL_TEMPLATE_UPDATED

  // Webhook events (2026-09-03) — `webhooks.controller.ts` dispatches these three
  // lifecycle events on the subscription row itself (create/update/delete a `Webhook`).
  // WEBHOOK_TRIGGERED/WEBHOOK_FAILED purged: a delivery attempt's outcome is logged
  // (`webhooks.service.ts#send`), never turned into a self-referential webhook event — nothing ever
  // dispatched either one.
  WEBHOOK_CREATED
  WEBHOOK_UPDATED
  WEBHOOK_DELETED

  // Purge (2026-09-03) of the remaining dead vocabulary flagged during an audit
  // ("une soixantaine de valeurs supplémentaires tout aussi mortes"): the
  // RECURRING_INVOICE_* family (7 + 3 item events — the feature itself has no `RecurringInvoice`
  // Prisma model any more, superseded by the generic document `schedules/cadence.ts`), every PLUGIN_*
  // member (9 — the external plugin mechanism's own removal took the only thing that could
  // ever have dispatched PLUGIN_WEBHOOK_RECEIVED with it; `plugins.controller.ts` exposes no inbound
  // webhook route at all), USER_*/OTP_*/APP_*(7 + 3 + 2 — auth and OTP never dispatched through this
  // module), EMAIL_*/MAIL_TEMPLATE_*(3 + 2), DASHBOARD_*/STATS_*/CURRENCY_*(5 + 2), SEARCH_PERFORMED,
  // PDF_GENERATED/XML_GENERATED/FILE_DOWNLOADED, every *_ITEM_* member (12 — line items never
  // dispatched their own webhook, only the parent document's DOCUMENT_* events do), PDF_CONFIG_*/
  // EMAIL_TEMPLATE_CREATED(3), every *_NUMBER_GENERATED member (4 — numbering is an internal
  // allocation, not an announced event), CRON_JOB_*(3), SSE_*(2), DATA_VALIDATED/
  // CONFIGURATION_VALIDATED — 73 members total (plus the 2 CLIENT_*, 2 COMPANY_* and 2 WEBHOOK_*
  // purged above, in their own family comments: 79 in all), every one checked individually by grep
  // (dispatch call sites, literal AND dynamic) with zero hits outside `event-formatters.ts` (dead
  // styles/formatters, removed alongside this) and generated/spec files. See the migration's own
  // header for the full grep methodology.
}

enum WebhookType {
  GENERIC
  DISCORD
  MATTERMOST
  SLACK
  TEAMS
  ZAPIER
  ROCKETCHAT
}

model Webhook {
  id     String         @id @default(cuid())
  url    String
  // AES-256-GCM encrypted (secret-crypto) HMAC signing secret when `CREDENTIALS_ENCRYPTION_KEY` is
  // configured — `WebhooksService#encryptSecretForStorage` writes it, `#resolveSecretForSigning`
  // decrypts it back right before signing an outgoing dispatch. Column type stays `String?`: a legacy
  // row written before this encrypted (or written while no key was set) still holds the plaintext
  // secret directly, told apart from the encrypted shape by `webhook-secret-format.ts` rather than by
  // any DB-level marker — `webhook-secret-migration.ts` sweeps those up idempotently at every boot.
  secret String?
  type   WebhookType    @default(GENERIC)
  events WebhookEvent[]

  // Link webhooks to a company (required)
  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  @@index([companyId])
}

// ======= INVITATION SYSTEM ======= //

model InvitationCode {
  id          String      @id @default(uuid())
  code        String      @unique
  createdAt   DateTime    @default(now())
  expiresAt   DateTime?
  usedAt      DateTime?
  createdById String
  createdBy   User        @relation("CreatedInvitations", fields: [createdById], references: [id], onDelete: Cascade)
  usedById    String?     @unique
  usedBy      User?       @relation("UsedInvitation", fields: [usedById], references: [id], onDelete: SetNull)
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role        CompanyRole @default(MEMBER)

  @@index([code])
  @@index([createdById])
  @@index([companyId])
  @@map("invitation_code")
}

enum CompanyOwnershipTransferStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELED
}

// A company's OWNER handing off the OWNER role to another user's account (product decision
// 2026-09-17, `modules/company/transfer/`) — a free-typed destination email, never an autocomplete
// over existing members (see `transfer.service.ts`'s own header on the anti-enumeration discipline
// this implies: the same generic response is returned whether or not an account exists for that
// email, and no row here is EVER created for an email that doesn't resolve to one — unlike
// `InvitationCode` above, which can mint a code for an email nobody has signed up with yet).
//
// PENDING until the destination user explicitly accepts (`POST /account/transfers/:id/accept`) or the
// 7-day window lapses (`transfer-expiry-sweep-runner.ts`, a BullMQ repeatable — never a Nest cron, see
// CLAUDE.md's own "Working with the owner" convention every sweep in this codebase already follows).
// `acceptedAt`/`canceledAt` are mutually exclusive with reaching EXPIRED — exactly one of the three
// terminal branches is ever taken from PENDING, enforced in `transfer.service.ts`, not by the schema.
model CompanyOwnershipTransfer {
  id String @id @default(cuid())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  status CompanyOwnershipTransferStatus @default(PENDING)

  // The OWNER who started this transfer — recorded explicitly (never re-derived from the company's
  // CURRENT owner list at finalize time) because `changeMemberRole`/a second, concurrent transfer
  // could otherwise have moved ownership around in between; this is who steps down to ADMIN when the
  // transfer completes, whoever else may also hold OWNER by then.
  fromUser   User   @relation("CompanyOwnershipTransferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  fromUserId String

  // The destination address as TYPED by the OWNER — kept verbatim (lower-cased/trimmed) purely for
  // display on the initiator's own pending-transfer card; never re-queried to resolve `toUser` (that
  // resolution happens exactly once, at creation, in `transfer.service.ts#initiateTransfer`).
  toEmail String

  // The EXISTING account `toEmail` resolved to at creation time — see this model's own header on why
  // a row is never created without one. `POST /account/transfers/:id/accept` requires the caller to
  // be signed in as exactly this user.
  toUser   User   @relation("CompanyOwnershipTransferTo", fields: [toUserId], references: [id], onDelete: Cascade)
  toUserId String

  expiresAt  DateTime
  acceptedAt DateTime?
  canceledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([toUserId])
  @@map("company_ownership_transfer")
}

// ======= BETTER AUTH INTEGRATION ======= //

model User {
  id            String        @id
  name          String?
  firstname     String
  lastname      String
  email         String
  emailVerified Boolean       @default(false)
  image         String?
  // Personal display + mail-language preference (product decision: language moves from a
  // browser-only setting to an account one). Set either at sign-up — the browser's detected
  // language, best-effort — or deliberately via `PATCH /api/auth-extended/preferences`. Nullable:
  // unset falls back to `Company.language` and then 'en' (`resolve-user-language.ts`), the same
  // three-step chain `Client.language` already resolves through for a document's recipient. Free
  // text, never a Prisma enum — same permissive-write/validated-read split as `Client.language`/
  // `Company.language` above: nothing here stops an unsupported value from being stored, only
  // `isSupportedRenderLanguage` ever picks one up. The one path that DOES reject an unsupported
  // value outright is the preferences endpoint itself, precisely because that one is a deliberate
  // choice from a fixed dropdown rather than raw storage.
  locale        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  apiKeys       ApiKey[]
  companies     UserCompany[]

  // Invitation relations
  createdInvitations InvitationCode[] @relation("CreatedInvitations")
  usedInvitation     InvitationCode?  @relation("UsedInvitation")

  // Ownership transfer relations (product decision 2026-09-17, `modules/company/transfer/`) — split
  // both directions the same way InvitationCode splits created/used above: one user can both HAND OFF
  // a company (fromUser) and RECEIVE one (toUser), sometimes at once, so a single unnamed relation
  // could not tell the two apart.
  ownershipTransfersInitiated CompanyOwnershipTransfer[] @relation("CompanyOwnershipTransferFrom")
  ownershipTransfersReceived  CompanyOwnershipTransfer[] @relation("CompanyOwnershipTransferTo")

  // Legal document acceptances (Terms of Service, Privacy Policy — see backend/src/legal/) — SaaS
  // mode only (`billing-flag.ts#isBillingEnabled`); empty on every self-hosted instance.
  legalAcceptances LegalAcceptance[]

  // One row per (slug, contentHash) release this user has already been emailed about — see
  // `LegalDocumentReleaseNotification`'s own comment. SaaS mode only, same as the acceptances above.
  legalDocumentReleaseNotifications LegalDocumentReleaseNotification[]

  @@unique([email])
  @@map("user")
}

/// One row per (user, document, contentHash) a user has explicitly accepted — the checkbox at
/// sign-up ("I accept the Terms of Service and the Privacy Policy", SaaS mode only) and the
/// re-acceptance interstitial a later text change triggers at sign-in
/// (`frontend/src/pages/legal/accept.tsx`). Never written on a self-hosted instance:
/// `isBillingEnabled()` gates every write path (`backend/src/legal/legal.service.ts`).
///
/// DECISION 2026-09-17 — keyed on `contentHash`, not `version`: `version` is free text an author sets
/// by hand in a document's front matter, and nothing stops two real text edits from landing under the
/// same version string on the same day (a same-day follow-up fix, forgetting to bump it a second
/// time) — which would make a stale acceptance silently keep counting as current. `contentHash` is a
/// sha256 of the normalized body (`legal-documents.ts#computeContentHash`) and can't be fooled that
/// way: any wording change is a different hash, full stop. `version` is kept as a column purely for
/// DISPLAY (an operator or a support reply naming "the version accepted"); the acceptance CHECK
/// (`legal-acceptance.ts#getPendingAcceptanceSlugs`) reads `contentHash` alone.
///
/// `contentHash` is nullable rather than backfilled: a migration that stamped every pre-existing row
/// with today's current hash would be LYING about what text that user actually saw at accept time (we
/// have no record of the wording as it was then). Leaving it `NULL` and treating a `NULL` as never
/// matching the current hash (see that same function) means an old row simply falls back to "still
/// pending" — the same outcome as if this column had existed from day one and that row had recorded a
/// now-superseded hash. No user is silently grandfathered in; the next sign-in interstitial asks them
/// to accept again, once, and the row gets a real hash from then on.
///
/// `ipAddress`/`userAgent` are best-effort evidence, not a data point the acceptance check itself ever
/// reads.
model LegalAcceptance {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentSlug String
  version      String
  /// sha256 of the document body at accept time (`legal-documents.ts#computeContentHash`). `NULL` on
  /// rows written before this column existed — see this model's own comment on why those are never
  /// backfilled and simply read back as stale.
  contentHash  String?
  acceptedAt   DateTime @default(now())
  ipAddress    String?
  userAgent    String?

  @@unique([userId, documentSlug, contentHash])
  @@index([userId])
  @@map("legal_acceptance")
}

/// One row per legal document text this instance has EVER shipped (its `(slug, contentHash)` pair),
/// recorded the first time a boot notices a slug's current hash isn't the latest one already on file
/// (`legal/legal-release-boot.service.ts`). Written on every instance, self-hosted included — this
/// table is the append-only history of "what changed and when", independent of whether anyone gets
/// emailed about it (that's `LegalDocumentReleaseNotification`, SaaS-only). `version` is carried along
/// purely so a release can be described in a log line or a future admin screen without a second
/// lookup into the (mutable, current-state-only) document files.
model LegalDocumentRelease {
  id          String   @id @default(cuid())
  slug        String
  version     String
  contentHash String
  publishedAt DateTime @default(now())

  @@unique([slug, contentHash])
  @@index([slug])
  @@map("legal_document_release")
}

/// One row per (user, slug, contentHash) this instance has already emailed "our legal documents have
/// changed" about — the idempotency key `legal-release-boot.service.ts` checks before sending, so a
/// re-run of the same boot-time detection (a restart, a multi-replica deployment where more than one
/// process notices the same new release) can never double-mail the same user for the same release.
/// SaaS mode only: nothing ever writes this row on a self-hosted instance, since nothing ever emails
/// there either (`billing-flag.ts#isBillingEnabled`).
model LegalDocumentReleaseNotification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String
  contentHash String
  sentAt      DateTime @default(now())

  @@unique([userId, slug, contentHash])
  @@index([userId])
  @@map("legal_document_release_notification")
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyPrefix  String
  keyHash    String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([companyId])
  @@map("api_key")
}

model Session {
  id              String   @id
  expiresAt       DateTime
  token           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ipAddress       String?
  userAgent       String?
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCompanyId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ======= END OF BETTER AUTH INTEGRATION ======= //

// ======= START OF LOGGING SYSTEM ======= //

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

model Log {
  id        String   @id @default(uuid())
  level     LogLevel
  category  String
  message   String
  timestamp DateTime @default(now())
  userId    String?
  path      String?
  details   Json
  // Which company this row is FOR — added long after `Log` itself (it predates multi-tenancy) once
  // every write site was threaded through to answer it (`@/logger/logger.service.ts`'s own header).
  // Nullable, and genuinely so, never a placeholder to backfill: a row written before this column
  // existed, and a genuinely instance-level event (a boot check spanning every company's data at once
  // — see `documents.service.ts#onModuleInit`'s `warnAboutUndeclaredStatuses`), both have no ONE
  // company to name.
  //
  // Deliberately a PLAIN string, never a `@relation` — the one `companyId` field in this whole schema
  // that isn't one, and on purpose: a log write must never fail because of what it is ABOUT. Two write
  // sites already, honestly, carry a `companyId` that may not resolve to any current `Company` row —
  // `payments-webhook.controller.ts`'s `:companyId` is a caller-supplied ROUTING hint, unverified until
  // deep inside `handleWebhookEvent` (that controller's own header), and
  // `billing/webhook-handlers.ts#recoverLegacySubscriptionCancellation` explicitly documents "a
  // companyId no Company row matches" as one of the two NORMAL reasons it runs at all. A real foreign
  // key would turn exactly those two documented, expected cases into a swallowed `Log` write (caught by
  // `createLog`'s own try/catch, `logger.service.ts`) — the DB audit trail disappearing for precisely
  // the anomalous/attack-adjacent traffic an operator would most want it for. No `onDelete: Cascade`
  // either, as a direct consequence: a deleted company's own log rows simply keep their (now
  // unresolvable) `companyId` — the same "row exists, id no longer resolves to a live company" shape
  // this column already has for a row written before it existed, never a reason to bulk-delete a
  // company's own history the moment the company itself goes away.
  companyId String?

  @@index([level])
  @@index([category])
  @@index([timestamp])
  // `modules/logger/logger.controller.ts#streamLogs`'s own query shape: filtered by `companyId`,
  // ordered by `timestamp` — a composite index serves that filter+sort together, rather than the
  // planner falling back to the bare `[timestamp]` index above and scanning past every OTHER
  // company's rows to find this one's most recent 100.
  @@index([companyId, timestamp])
}

// ======= END OF LOGGING SYSTEM ======= //

// ======= START OF DOCUMENT DESCRIPTOR SYSTEM ======= //
// backend/src/modules/documents. A document TYPE (its fields, its actions) is declared in code as
// a descriptor (see descriptors/quote.descriptor.ts) — nothing here names a document type. This is
// the one generic envelope every type's instances are stored in: `typeId` says which descriptor
// produced `data`, `status` is whatever vocabulary that type's actions use (no fixed enum — a
// second document type may need statuses this one never will), and `data` is the field values
// keyed by the descriptor's field.key, exactly as the form submitted them.

model DocumentInstance {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  typeId    String
  status    String   @default("draft")
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The document's NUMBER — see documents/numbering/. Null for every record until it first enters
  // its type's own declared `numbering.onEnterStatus` (descriptors/types.ts); a type that declares no
  // `numbering` at all (e.g. "expense") NEVER sets these, on any record, ever. Once set, NEVER
  // cleared or reassigned by anything in this codebase — a re-send does not renumber. `number` is the
  // raw sequence value (for sorting/uniqueness-per-sequence); `displayNumber` is `number` already run
  // through the company's own format pattern AT THE MOMENT it was taken (numbering/format-number.ts)
  // — frozen at issuance, deliberately: reformatting on every read would let a LATER change to the
  // company's format pattern silently rewrite an already-issued document's number.
  number        Int?
  displayNumber String?

  // Portugal's ATCUD ("Código Único de Documento") — `ATCUD:CodigodeValidação-NumeroSequencial`
  // (Portaria n.º 195/2020, art. 4.º n.º 1 — see country-policy/data/pt.json's own `invoice.send`
  // notes for the verbatim citation), computed and frozen the SAME moment `displayNumber` above is
  // (numbering/atcud.ts's `computeAtcud`, wired from `actions/atcud-issuance.ts`) — never
  // recomputed on a later read, for the exact same reason `displayNumber` itself is frozen: a
  // company editing or deleting its AT validation code afterward must never silently rewrite an
  // already-issued invoice's own printed ATCUD. Null for every record that is not a numbered
  // Portuguese invoice — every other country's document, and every Portuguese document type other
  // than "invoice" (this branch has no numbering at all for "credit-note", the only other
  // fiscally-relevant PT type — see credit-note.descriptor.ts's own header), leaves this column
  // untouched forever.
  atcud String?

  // The error from the most recent FAILED asynchronous action — see documents/queue/ (TODO item 22)
  // and descriptors/lifecycle.ts's own comment on the "sending"/"send_failed" statuses a type with a
  // "send" action declares. Set ONLY by queue/mark-send-failed.ts, once BullMQ has exhausted every
  // retry for a document-action job; cleared (set back to null) by every ORDINARY write this
  // instance goes through afterwards (`persistence.ts`'s `upsertDocument`, the same call "save-draft"
  // and the first phase of "send" already make) — a stale failure from a PREVIOUS attempt must never
  // linger next to a document that has since moved on. Never touched by a type with no "send" action
  // at all (e.g. "expense") — nothing ever writes to this column for one. Visible on the document
  // list and detail screens so a failed send is never a silent state only a server log knows about.
  lastActionError String?

  // The identifier a TRANSPORT handed back on successful delivery — e.g. the PDP deposit id
  // (`transports/pdp-transport.ts`) or superpdp's own invoice id. Generic on this table (like
  // `lastActionError` above) rather than a PDP-specific column: any future transport that hands back
  // a reference gets the same slot, no schema change. Absent for the "email" transport (nothing to
  // record) and for every type with no transport at all (quote/credit-note) — set by
  // `persistence.ts#confirmDelivery`, the moment delivery genuinely succeeds
  // (`actions/async-send.ts`'s phase-2), DELIBERATELY BEFORE the write that moves the record to
  // "sent" (see `deliveryConfirmedAt` below for why that ordering is load-bearing) — never touched by
  // an ordinary `upsertDocument` write the way `lastActionError` is (there is nothing stale to clear:
  // a reference is only ever written once delivery actually succeeds).
  transportRef String?

  // The registered transport ("pdp"/"ksef"/"sdi"/…, `transports/transport-registry.ts` ids) that
  // ACTUALLY delivered this document — set on the SAME write as `transportRef` above, for the exact
  // same reason and by the exact same caller (`persistence.ts#confirmDelivery`). Needed
  // because `Company.invoiceTransportId` is the company's CURRENT choice, which can change after this
  // document was sent — the post-deposit conformity poll (`conformity/`) must poll the
  // channel this document actually went through, never whatever the company happens to have
  // configured today. Null for "email" (no concept of a provider-side conformity verdict to poll) and
  // for every type with no transport at all — the poll sweep's own eligibility query
  // (`conformity/authority-events.persistence.ts`) filters on this column being one of the REGISTERED
  // pollers' own provider ids, so a transport that never registers a poller (e.g. "sdi" — push-only
  // SOAP notifiche, nothing to poll, see `conformity/pollers/`'s own header) is simply never selected,
  // no matter what this column holds.
  channelProviderId String?

  // THE CROSS-PROCESS, POST-DELIVERY GUARANTEE — set by `persistence.ts#confirmDelivery`, in the
  // SAME write as `transportRef`/`channelProviderId` above, the instant `deliver()`
  // (`actions/async-send.ts`) has genuinely returned success, and BEFORE the record is ever moved to
  // "sent". Exists to close a gap the in-process/in-memory guard (`async-send.ts`'s own
  // `inFlightDeliveries` Set) cannot: that Set only ever protects a single process, so once the API
  // and a BullMQ worker (or several replicas of either) run separately, a retry that lands on a
  // process with no memory of the first attempt would otherwise re-read a "sending" row, see nothing
  // to stop it, and call `deliver()` a SECOND time — a real second email or authority deposit, not a
  // theoretical one. This column is the durable fact a retry checks FIRST: non-null means "delivery
  // already happened for this 'sending' episode", so `async-send.ts`'s phase-2 skips `deliver()`
  // entirely and only finishes whatever write never completed — see that file's own header for the
  // full guarantee this makes possible (an unbounded number of safe status-write retries once
  // delivery itself is durably confirmed). Never cleared once set — not by `upsertDocument`'s
  // ordinary `lastActionError` reset, not by a later "send_failed" — a "send_failed" → "sending" retry
  // (a human clicking Retry after every BullMQ attempt was spent on the FINAL write alone) must still
  // see it and still refuse to call `deliver()` again. Null for every document whose delivery has
  // never yet succeeded, and forever for any type with no "send" action at all.
  deliveryConfirmedAt DateTime?

  // See DocumentAuthorityEvent below (conformity/) — the post-deposit conformity journal:
  // every event the ISSUING PLATFORM itself reported for this document (fr:200/201/202/213 for PDP,
  // …), append-only. Never drives `status` above — see that model's own header for why the declared
  // lifecycle and the platform's own verdict are deliberately two separate facts.
  authorityEvents DocumentAuthorityEvent[]

  // Set ONCE this document's conformity poll has nothing left to ever learn — a REAL terminal
  // verdict (PDP fr:202/fr:213, …) or a synthetic 'poll:gave-up' (conformity/conformity-sweep.ts),
  // written by `conformity/conformity-sweep-runner.ts` at the exact moment it makes that call. THE
  // reason `conformity/authority-events.persistence.ts#findConformitySweepCandidates` can filter this
  // column directly in SQL instead of loading every "sent" document on a pollable channel — including
  // ones resolved years ago — and re-deriving "already terminal" from a freshly re-joined
  // `authorityEvents` table on every 60s pass, forever. Deliberately NOT derived here from a
  // `statusCode` enumeration: only the poller that produced a code knows whether ITS OWN vocabulary
  // calls it terminal (`conformity/authority-status-poller.ts`'s own header) — this column just
  // records the fact once the runner has already decided it, never re-decides it itself. Null for
  // every non-terminal "sent" document AND for every row that predates this column (self-healing: the
  // sweep backfills it the next time it visits an already-terminal row it had not marked yet, see
  // that runner's own comment on the 'skip' branch).
  conformityResolvedAt DateTime?

  // Legal archiving: the error from the most recent FAILED archiving attempt
  // (documents/archive/archive-on-send.ts), deliberately its OWN column, never `lastActionError`
  // above. Two reasons: (1) `lastActionError` is reset to null by EVERY ordinary write this instance
  // goes through (`persistence.ts`'s `upsertDocument`) — a re-send (a fresh "sending" write) would
  // silently erase a still-true archiving failure that has nothing to do with THAT write; (2)
  // `lastActionError` is semantically "the declared ACTION failed" (a send that never delivered) —
  // archiving failing is a DIFFERENT fact: the delivery genuinely succeeded (the email left, the
  // deposit was accepted), archiving it afterwards is what did not. Conflating the two would make a
  // real, disclosed delivery look like a failed one, or bury an undisclosed archiving gap behind a
  // send that reads as a clean success. Set ONLY by `archive-on-send.ts` (error message on failure,
  // cleared back to null the moment a LATER archiving attempt for the same document succeeds — a
  // re-send re-archives, see DocumentArchive below); never touched by any other write path. Visible
  // on the document screen so a silent archiving gap is never only a server log line.
  lastArchiveError String?

  // See DocumentPayment below (settlement/) — a payment is NOT a document type of its own (no
  // lifecycle, no draft, no send), only a record hanging off an existing document instance.
  payments DocumentPayment[]

  // Automatic reminders — see DocumentReminder below (reminders/). One row per ESCALATION TIER
  // CLAIMED for this document, created BEFORE the email is sent and released again if the send then
  // fails (reminder-sweep-runner.ts#claimReminderTier/releaseReminderClaim) — a document can
  // accumulate up to `REMINDER_TIERS.length` surviving rows over its overdue life (reminder-sweep.ts),
  // one per crossed threshold that was actually delivered.
  reminders DocumentReminder[]

  // See DocumentArchive below (archive/) — one row per successful delivery that produced at least
  // one artifact, never a "current archive" singleton: a re-send after "send_failed" archives AGAIN
  // (archive/archive-on-send.ts's own header — two archives for the same document are two dated
  // facts, not a conflict).
  archives DocumentArchive[]

  // Public download links — see DocumentDownloadToken below. A document can have several (a re-share, a
  // link for two different recipients); each is its own row, never overwritten.
  shareLinkTokens DocumentDownloadToken[]

  // Electronic signature — see Signature model below. A document can have several across its
  // life (a fresh request after the previous one locked out) — never overwritten, the same "one row
  // per grant" posture `shareLinkTokens` above already holds.
  signatures Signature[]

  // Time tracking & project invoicing — see TimeEntry below. Every time entry this INVOICE (never any other
  // type — nothing bills a quote or a credit note) was generated from, once billed. `onDelete:
  // SetNull` on TimeEntry's own side (not a cascade): deleting a still-draft invoice must free the
  // entries it consumed back to "unbilled", never take them down with it — a time entry is a fact
  // about work actually performed, independent of whether the invoice it was once attached to survives.
  timeEntries TimeEntry[]

  // Bank reconciliation ("rapprochement bancaire") — see BankStatementLine below. Every bank
  // statement line that was reconciled AGAINST this invoice — `onDelete: SetNull` on
  // BankStatementLine's own side (not a cascade), the same reasoning `timeEntries` above already
  // gives: a bank line is a fact about money that really arrived, independent of whether the invoice
  // it was matched to survives.
  bankStatementReconciliations BankStatementLine[]

  // Online payment ("paiement en ligne") — see PaymentCheckoutSession below. Every checkout
  // session ever opened against this invoice (a client can abandon one and try again, so this is a
  // list, not a nullable single row).
  paymentCheckoutSessions PaymentCheckoutSession[]

  @@index([companyId, typeId])
  // `persistence.ts#listDocumentsPage` (`GET /documents`'s own paginated read) — one type's own rows,
  // for one company, ordered most-recently-updated-first, is the DEFAULT view before any filter is
  // even touched (no status picked, no search typed). `companyId, typeId` alone (the index right
  // above) still narrows Postgres to the right rows first; adding `updatedAt` lets it walk that
  // narrowed set ALREADY IN ORDER instead of narrowing then sorting — the one figure that actually
  // changes with a table's size, and the whole reason a page + total went from a single unindexed
  // `take: 50` to a real, paginated query in the first place.
  @@index([companyId, typeId, updatedAt])
  // What `conformity/authority-events.persistence.ts#findConformitySweepCandidates` actually filters
  // on, in this order — status/channelProviderId/conformityResolvedAt narrow a large table down to
  // "sent on a pollable channel, not yet resolved" before Postgres ever has to look at transportRef or
  // join authorityEvents.
  @@index([status, channelProviderId, conformityResolvedAt], map: "document_instance_conformity_sweep_idx")
}

// A RECURRENCE: "replay ACTION on SOURCE DOCUMENT, on this cadence" — generic on
// purpose, the same way DocumentInstance itself names no document type. The invoice case (a schedule
// whose actionId is "duplicate", sourceDocumentId a model invoice) is the FIRST consumer, never the
// only one this table can describe: nothing here mentions "invoice". See
// documents/schedules/cadence.ts for the pure next-occurrence math this model's own
// nextRunAt/anchorDay feed, and documents/queue/processors/document-action.processor.ts for how a
// due schedule's occurrence actually runs (through DocumentsService.runAction — the SAME four gates
// any other action goes through, country policy included).
model DocumentSchedule {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  // Which document type's registry/descriptor this schedule acts against, and which of ITS OWN
  // instances is the "template" being replayed — never validated against the live
  // DocumentTypeRegistry here, the same deliberate looseness DocumentCountryActionRule.typeId
  // documents for its own typeId column: the schema and the live registry are two independent
  // sources, reconciled at RUN time (DocumentsService.runAction 404s a typeId/action it doesn't
  // know), never at the database layer.
  typeId           String
  sourceDocumentId String
  actionId         String

  // One of "weekly" | "monthly" | "quarterly" | "yearly" — a plain string, not a Prisma enum, the
  // same choice DocumentInstance.status already makes: closed at the APPLICATION layer
  // (documents/schedules/cadence.ts's own union), not the database's. Deliberately NOT the old,
  // orphaned `RecurrenceFrequency` enum a few hundred lines up (WEEKLY/BIWEEKLY/MONTHLY/BIMONTHLY/
  // QUARTERLY/QUADMONTHLY/SEMIANNUALLY/ANNUALLY, git tag `avant-refonte-documents`'s
  // RecurringInvoice) — four closed cadences, deliberately, not eight, and no RRULE.
  cadence String

  // The day-of-month THIS schedule targets for monthly/quarterly/yearly cadences — fixed once, at
  // creation, from the first occurrence's own UTC day-of-month, and reused for every later
  // occurrence's clamp-to-month-end math (see cadence.ts's own header for why re-deriving it from
  // the PREVIOUS occurrence's day, once that day was itself clamped by a short month, would let a
  // 31-anchored schedule drift down to the 28th forever instead of returning to the 31st the next
  // long month). Unused (left null) for "weekly", which has no month to anchor a day within.
  anchorDay Int?

  // The next occurrence's date, UTC-midnight-normalized (see cadence.ts's own header on the timezone
  // choice) — what the sweep (documents/schedules/schedule-sweep.ts) compares against "now" to decide
  // this schedule is due. Advanced by the sweep itself, by cadence.ts's pure computeNextOccurrence,
  // the INSTANT an occurrence is enqueued — never only once that occurrence's own job has finished
  // (see schedule-sweep-runner.ts's own header for why the two are deliberately independent writes).
  nextRunAt DateTime

  // The occurrence date most recently DISPATCHED (set by the sweep alongside nextRunAt above) — NOT
  // "most recently succeeded": a schedule whose latest dispatch failed still moves this forward, the
  // same "the pointer always advances, only lastError says whether it worked" split
  // `DocumentInstance.lastActionError` already holds relative to `status`.
  lastRunAt DateTime?

  // The most recent occurrence's failure, if any — 403 country policy, 400 validation, or a
  // delivery failure two hops downstream (a chained "then send" — see schedule-sweep-runner.ts's own
  // header for why that one is NOT reflected here). Cleared (set back to null) the next time an
  // occurrence of THIS schedule succeeds — never left stale once the underlying cause is fixed, the
  // same convention `DocumentInstance.lastActionError` already holds for an ordinary document write.
  // Never causes `enabled` to flip on its own: see `enabled`'s own comment.
  lastError String?

  // Whether the sweep considers this schedule at all. A schedule that fails an occurrence is NEVER
  // auto-disabled — only `lastError` above records the failure — because a country-policy block or a
  // validation gap can be fixed without the human having to remember to re-enable a schedule that
  // silently stopped running: never a silent deactivation, deliberately.
  // Only a human, from the schedules screen, ever flips this.
  enabled Boolean @default(true)

  // Per-schedule options the generic engine does not need to understand structurally — today, only
  // the invoice case's `{ thenSend: boolean }` (chain "send" onto the fresh duplicate — see
  // duplicate-extension.ts). A future action/type can grow this bag without a migration, the same
  // "an opaque, action-owned params object" discipline DocumentActionJobData.payload.params already
  // holds.
  params Json?

  createdAt DateTime @default(now())

  @@index([companyId, typeId])
  // What the sweep itself actually queries by — see schedule.persistence.ts's listDueSchedules.
  @@index([enabled, nextRunAt])
}

// One PAYMENT recorded against a document instance (the invoice, today — see the "record-payment"
// action, documents/actions/invoice-actions.ts). Deliberately NOT a document type: no `statuses`, no
// `initialStatus`, no lifecycle at all — recording one is a single, complete act, not something that
// moves through draft/sent. `amountMinor` is in MINOR units, same discipline as compute-totals.ts's
// own totals, for the same reason: floats do not add up to zero. See settlement/compute-settlement.ts
// for the balance this feeds, and that file's own comment on why a credit note is NOT one of these —
// that reconciliation (lettrage) is separate, future work.
model DocumentPayment {
  id         String           @id @default(cuid())
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  document   DocumentInstance @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  // The amount ACTUALLY received, in the payment's OWN currency (`currency` below) — exactly what
  // was typed into the "record-payment" dialog, never adjusted. Kept verbatim even when it differs
  // from the document's own currency — this is the audit trail of what the
  // customer really paid; `documentAmountMinor` below is the DERIVED figure settlement math uses.
  amountMinor Int
  // The payment's OWN currency — no longer required to equal the document's own (a mismatch is
  // now CONVERTED at a dated rate instead of refused — see `settlement/convert-payment.ts`). Stored
  // here so a read never needs to re-resolve the document's field data just to know what
  // `amountMinor` is denominated in.
  currency    String

  // Fixes a past gap in this schema ("les taux existent, mais...
  // ne convertissent toujours pas") — the WHY is "un taux PAR OPÉRATION
  // (saisi au moment du paiement, STOCKÉ SUR LUI), pas le taux ambiant de la société": exactly
  // these four fields. `documentAmountMinor` is `amountMinor` converted into the DOCUMENT's own
  // currency at the rate dated to `paidAt` (settlement/convert-payment.ts's `resolvePaymentConversion`),
  // resolved ONCE, at record time, and NEVER recomputed on a later read — `CurrencyRate` rows are
  // themselves append-only (no PATCH/DELETE, see that model's own comment), but a NEW row entered
  // LATER with an `asOf` that lands between two already-resolved dates would otherwise silently
  // change which row a fresh lookup picks for this same `paidAt`, retroactively rewriting an
  // already-reported balance (or un-firing a DOCUMENT_SETTLED webhook already sent). Pinning here is
  // what makes settlement/compute-settlement.ts's own arithmetic — and the DOCUMENT_SETTLED crossing
  // check (settlement/document-settled.ts) built on it — an EXACT WRITE, never a moving target.
  // Equal to `amountMinor` (same figure, same currency) whenever `currency` already matches the
  // document's own — the trivial, no-conversion case; `conversionRate`/`conversionRateAsOf`/
  // `conversionSource` stay null then, mirroring `CurrencyAmount`'s own "nothing to convert, nothing
  // to disclose" convention (contributions/currency-consolidation.ts).
  documentAmountMinor Int
  // The resolved `CurrencyRate.rate` (units of the document's currency per one unit of the
  // payment's), null exactly when `documentAmountMinor === amountMinor` (no conversion applied).
  conversionRate      Decimal?
  // The dated `CurrencyRate.asOf` this rate was resolved from — DIFFERENT from `paidAt`: the rate
  // is the most recent one on or before `paidAt` (convert.ts's `resolveLatestRate`), not necessarily
  // dated to the exact same instant.
  conversionRateAsOf  DateTime?
  // Mirrors `CurrencyRate.source` ("manual" today) — carried through so a read never needs to
  // re-join `CurrencyRate` just to say where the pinned rate came from.
  conversionSource    String?

  // A `payment-methods/built-in.ts` id ("bank_transfer", "paypal", "cash", "cheque", "stripe") for a
  // row recorded after that module shipped — never a legal classification, see invoice.descriptor.ts's
  // own comment on the "record-payment" action's `method` param. A row recorded BEFORE it (this
  // column predates the typed registry) may still carry one of the two OLD bare-string labels that
  // module never reused ("card", "other" — see built-in.ts's own header): this column was never an
  // enum, so nothing here changed at the DATABASE level, only what a NEW write is checked against.
  // `PaymentMethodRegistry.resolve()` returns undefined (never throws) for a value it never
  // registered, precisely so a reader of an old row degrades to showing the raw string honestly,
  // rather than crashing on data that was always valid for this column.
  method String?
  paidAt DateTime
  note   String?

  createdAt DateTime @default(now())

  // Bank reconciliation ("rapprochement bancaire") — the bank statement line that CAUSED this
  // payment to be recorded, when it was created by a reconciliation rather than typed in by hand
  // (`bank-reconciliation/bank-reconciliation.service.ts`). At most one line ever points here (a line
  // can be reconciled once — see BankStatementLine's own `@@unique`), but this side is still declared
  // as a list, the same one-sided-list shape Prisma requires for every OTHER optional back-relation on
  // this exact model (see e.g. `DocumentInstance.timeEntries` for the identical pattern with TimeEntry).
  reconciledBy BankStatementLine[]

  // Online payment ("paiement en ligne") — the checkout session that PRODUCED this payment,
  // when it was recorded by a provider webhook rather than typed in by hand or reconciled from a bank
  // statement (`payments/payment-sessions.service.ts`). `onDelete: SetNull` on the session's own side
  // (see `PaymentCheckoutSession.payment` below), the exact same "a payment is a fact about money that
  // really arrived, independent of whether the record that first pointed at it survives" reasoning
  // `reconciledBy` just above already holds for a bank line.
  fromCheckoutSession PaymentCheckoutSession[]

  @@index([companyId, documentId])
}

// Online payment ("paiement en ligne") — one attempt to pay an invoice through an external
// payment provider's OWN hosted page (Stripe Checkout today — see `payments/provider.ts`'s own header
// for why this is a narrow interface + registry, never a `PluginRegistry` entry). This table exists
// for exactly two reasons neither `DocumentPayment` nor the provider itself can give:
//
//  1. THE AMOUNT CHARGED, pinned at session-creation time. `amountMinor`/`currency` are read from
//     `settlement/compute-settlement.ts`'s own `outstandingMinor` the INSTANT the client clicks "Pay"
//     (`PaymentSessionsService.createInvoiceCheckoutSession`) — never re-derived from anything the
//     provider or the browser later sends back. A webhook event never carries a trustworthy amount of
//     its own reason to charge; this row is the one place that says what THIS session was actually
//     opened for.
//  2. REPLAY SAFETY. `status` starts PENDING and is flipped to COMPLETED by an ATOMIC, conditional
//     `UPDATE ... WHERE status = 'PENDING'` (`payment-sessions.persistence.ts#claimSessionForCompletion`,
//     the exact same claim-then-act shape `bank-reconciliation/persistence.ts#claimLineForReconciliation`
//     already uses for the identical "an external event must credit a document AT MOST ONCE" problem).
//     A provider redelivering the SAME webhook event (its own documented at-least-once contract) finds
//     the row already COMPLETED and does nothing — never a second `DocumentPayment`.
//
// `@@unique([providerId, providerSessionId])` is what makes a session individually addressable from an
// inbound webhook, which carries the PROVIDER's own session id, never this row's own `id`.
model PaymentCheckoutSession {
  id         String           @id @default(cuid())
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  document   DocumentInstance @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  // A `payments/payment-provider-registry.ts` id — "stripe" today, the same "a provider registers
  // itself under an id" convention `transports/transport-registry.ts`'s own `providerId` already holds.
  providerId        String
  // The PROVIDER's own session/checkout id (Stripe's `cs_...`) — what an inbound webhook event names,
  // never this row's own `id`. Unique per provider (never reused): what makes `findSessionByProviderRef`
  // an exact, non-ambiguous lookup.
  providerSessionId String

  status PaymentCheckoutSessionStatus @default(PENDING)

  // The OUTSTANDING amount this session was opened to collect, pinned at creation time (see this
  // model's own header, point 1) — NEVER recomputed on webhook receipt, and never trusted from
  // anything the provider or the browser sends back.
  amountMinor Int
  currency    String

  // The provider's OWN hosted payment page — never rendered by this app (see `provider.ts`'s own
  // header: "the payment page is the provider's own hosted surface; this app holds a session id and a
  // status, nothing more"). Kept so a client re-opening an already-pending session can be handed the
  // SAME link rather than a second, orphaned one.
  checkoutUrl String

  // Set the instant `claimSessionForCompletion` wins the race AND `record-payment` succeeds — see
  // `payment-sessions.service.ts#handleWebhookEvent`'s own header for the exact ordering and what a
  // failure between the two steps leaves behind. `onDelete: SetNull`: deleting the payment it produced
  // (this codebase never does, but see `DocumentPayment`'s own header) must not take this audit row
  // down with it.
  payment   DocumentPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  paymentId String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  // Never two sessions credited to the SAME payment row — a data-integrity backstop against a future
  // bug in this module, the identical reasoning `BankStatementLine`'s own `@@unique([reconciledPaymentId])`
  // already documents for the equivalent field. Postgres never treats two NULLs as a duplicate under a
  // unique constraint, so this activates only once `paymentId` is actually set.
  @@unique([paymentId])
  @@unique([providerId, providerSessionId])
  @@index([companyId, documentId])
}

enum PaymentCheckoutSessionStatus {
  // The ordinary resting state between "the client clicked Pay" and "the provider told us what
  // happened" — also the state a webhook redelivery finds once this session has already been claimed
  // by an EARLIER delivery of the SAME event (see this model's own header, point 2) or released back
  // after a "record-payment" failure (`payment-sessions.persistence.ts#releaseSessionClaim`) — a
  // session that failed to record is retryable, never stuck.
  PENDING
  // Exactly one `DocumentPayment` was created from this session — `paymentId`/`completedAt` are set
  // together, on the SAME atomic claim, never independently. Terminal: nothing in this module ever
  // moves a session back out of this status.
  COMPLETED
  // The provider itself reported the checkout did NOT succeed (an expired session, a declined card) —
  // distinct from PENDING (which still might complete) and from COMPLETED (which did): a client sees
  // this and can open a fresh session for the same invoice.
  FAILED
}

// Bank reconciliation ("rapprochement bancaire par import de relevé") — a single imported bank
// statement file (CSV or OFX) and the individual transaction lines read from it. Deliberately its OWN
// pair of tables, never folded into DocumentInstance/DocumentPayment: a statement is not a document
// this company issues (no lifecycle, no descriptor, no numbering — the same reasoning DocumentPayment's
// own header already gives for why a payment isn't one either), and a LINE only ever produces a real
// DocumentPayment once a human confirms a match — see `bank-reconciliation/bank-reconciliation.service.ts`'s
// own header for the full "machine proposes, human commits" discipline this schema exists to enforce.
enum BankStatementFormat {
  CSV
  OFX
}

enum BankStatementLineStatus {
  // The ordinary, honest resting state for a line nothing has been confirmed for yet — whether that
  // is because nothing matched (see bank-reconciliation/matching.ts's own header: amount alone is
  // NEVER enough to suggest a match, so most real statements leave some lines here permanently — a
  // bank fee, an owner's own transfer) or because a suggestion exists but no one has confirmed it.
  // Never an error state, and nothing sweeps it automatically — see this enum's own module header.
  UNMATCHED
  // Exactly one `DocumentPayment` was created from this line — `reconciledDocumentId`/
  // `reconciledPaymentId`/`reconciledAt` are then all set together (`bank-reconciliation.service.ts`'s own atomic
  // claim). Terminal: nothing in this module ever moves a line back out of this status (the payment
  // it produced would have to be un-recorded first, which `settlement/payments.ts`'s own header
  // already states this codebase never does for ANY payment, hand-entered or reconciled alike).
  RECONCILED
}

// One imported file. `currency` is the statement's OWN single declared currency — set once, by the
// human doing the import (see bank-reconciliation/parse-csv.ts's own header for why this schema never
// tries to detect a currency from a CSV, which has no standard column for one): a multi-currency
// account is out of scope for this feature — a bank issuing several currencies from one account
// exports one file (and one currency) per statement, which is exactly what one row here models.
model BankStatement {
  id         String              @id @default(cuid())
  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  fileName   String
  format     BankStatementFormat
  currency   String
  importedAt DateTime            @default(now())
  lines      BankStatementLine[]

  @@index([companyId])
}

// One transaction line read from a statement, in the ORDER it appeared in the file (`lineIndex`) —
// never re-sorted, so a support conversation about "line 12 of the file I uploaded" always means the
// same row. `amountMinor` keeps whatever SIGN the statement itself carried (a debit line — money OUT
// — is still imported and shown, never silently dropped: see this schema's own module header, "the
// normal case, not an error") — only a POSITIVE line (money IN) is ever a candidate for
// reconciliation, enforced by bank-reconciliation/bank-reconciliation.service.ts, never by a constraint here (a negative
// line is a perfectly valid ROW, just never a reconcilable one).
model BankStatementLine {
  id                   String                  @id @default(cuid())
  statement            BankStatement           @relation(fields: [statementId], references: [id], onDelete: Cascade)
  statementId          String
  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId            String
  lineIndex            Int
  // The bank's own posting/value date for this transaction — UTC midnight, the same "a date-only
  // fact stores as a UTC-midnight Date, never a local-timezone one" discipline
  // settlement/convert-payment.ts's own header documents at length for the identical trap.
  date                 DateTime
  amountMinor          Int
  // The raw transaction description/label the bank exported (OFX's MEMO/NAME, or the CSV column the
  // human mapped to it at import time) — what bank-reconciliation/matching.ts searches for an
  // invoice's own displayNumber (its "reference" match signal).
  label                String
  // A SEPARATE, structured reference column, when the source format actually has one (OFX's own
  // FITID; a CSV column the human explicitly mapped) — kept apart from `label` (free text) because a
  // structured reference is a STRONGER signal than a substring match against a free-text label; null
  // when the format/mapping carries none, never guessed from `label` itself.
  reference            String?
  // The untouched parsed row, header-keyed for a CSV or tag-keyed for OFX — kept verbatim so a
  // support conversation ("why didn't line 12 match?") can be answered by reading back exactly what
  // was imported, without re-parsing the original file.
  raw                  Json
  status               BankStatementLineStatus @default(UNMATCHED)
  // The three facts below are written TOGETHER, exactly once, by `bank-reconciliation.service.ts`'s
  // own atomic claim — never independently, and never by anything else in this codebase (no PATCH
  // endpoint exists for any of the three). `onDelete: SetNull` on both relations (never Cascade): a bank line is a
  // historical fact about money that arrived; if the invoice or the payment it produced is later
  // deleted, the line itself must survive, only forgetting which one it was reconciled to — the exact
  // same reasoning DocumentInstance's own `timeEntries` relation already documents for TimeEntry.
  reconciledDocument   DocumentInstance?       @relation(fields: [reconciledDocumentId], references: [id], onDelete: SetNull)
  reconciledDocumentId String?
  reconciledPayment    DocumentPayment?        @relation(fields: [reconciledPaymentId], references: [id], onDelete: SetNull)
  reconciledPaymentId  String?
  reconciledAt         DateTime?

  // NOT what stops the SAME LINE from being reconciled twice — that guarantee is the atomic,
  // conditional `UPDATE ... WHERE id = ? AND status = 'UNMATCHED'` `bank-reconciliation.service.ts`'s
  // own claim step issues (a row-level lock Postgres itself serializes, so a genuine race between two
  // concurrent requests still leaves exactly one winner — see that file's own header). This constraint closes a
  // narrower, separate hole instead: it makes it impossible for the SAME `DocumentPayment` to ever end
  // up referenced by two different lines, a data-integrity backstop against a future bug in this
  // module, not a business rule a user could otherwise trigger. Postgres never treats two NULLs as a
  // duplicate under a unique constraint, so this activates only once `reconciledPaymentId` is actually
  // set — every still-UNMATCHED line's own null is unaffected.
  @@unique([reconciledPaymentId])
  @@index([companyId, status])
  @@index([statementId])
}

// Automatic reminders ("relances automatiques") — one row per ESCALATION TIER actually emailed
// for an overdue document. The `@@unique([documentId, tier])` below IS the "once per tier, ever"
// guarantee this whole feature runs on: `reminders/reminder-sweep-runner.ts` writes this row ONLY
// AFTER `MailService.sendMail` has already succeeded for that tier, and a row already present for
// (documentId, tier) means that escalation step is done — a later daily pass, or two overlapping
// ones (the identical race `conformity-sweep.ts`'s own header documents at length for its own
// jobId), can never re-send the SAME tier. If two concurrent passes still both observe "not sent
// yet" and both call `sendMail` (a genuine race, not merely a slow query), the SECOND write's own
// unique-constraint violation is what actually stops the duplicate from being durably double-
// recorded — see that runner's own header for why a caught P2002 there is treated as "already sent",
// never a crash (the identical "belt and suspenders" posture `authority-events.persistence.ts`'s own
// `skipDuplicates` gives the conformity journal).
//
// Invoices only, for now — this feature's own accepted scope, and `reminder-sweep.ts`'s own
// header on unsigned quotes being a deliberate non-goal THIS pass — but nothing about this table
// names "invoice": `documentId` is a bare FK to ANY `DocumentInstance`, exactly like
// `DocumentPayment.documentId` above, so extending this to a quote-signature reminder later needs no
// schema change, only a second overdue predicate feeding the same runner.
model DocumentReminder {
  id         String           @id @default(cuid())
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  document   DocumentInstance @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  // Which escalation step this row represents — the SAME number as the matching `REMINDER_TIERS`
  // entry's own `daysOverdue` (reminder-sweep.ts), e.g. 7/14/30. A plain `Int`, not an enum: the
  // tier set is an application-level constant a later task can extend without a migration, the same
  // "closed at the application layer, not the database's" choice `DocumentInstance.status` and
  // `DocumentSchedule.cadence` already make.
  tier Int

  // WHEN this tier's slot was claimed, just before the send attempt — set once, at write time, never
  // updated afterwards. A row that SURVIVES (the common case: the send succeeded, or a later send
  // attempt is still in flight) means this tier's email genuinely went out at essentially this instant;
  // a row created here and then the send fails is DELETED again by
  // reminder-sweep-runner.ts#releaseReminderClaim, so what remains keeps meaning "sent", not "attempted"
  // — see that file's own header ("Reservation, not record-after-send") for why claim now precedes send
  // rather than following it, and the one residual case (the release write itself also failing) where a
  // claimed-but-undelivered row can persist, always paired with a PERSISTED log entry when that happens.
  sentAt DateTime @default(now())

  @@unique([documentId, tier])
  @@index([companyId])
}

// Legal archiving (⚖ — retention per country, integrity). One row per DELIVERY that
// produced at least one artifact — written ONLY by documents/archive/archive-on-send.ts, at the
// moment `actions/async-send.ts`'s phase-2 delivery actually succeeds (see that file's own header).
// NOT a "current archive" singleton per document: a re-send after "send_failed" archives AGAIN — two
// archives for the same document are two DATED FACTS (two real deliveries), never a conflict to
// resolve or a row to overwrite.
//
// IMMUTABLE BY DESIGN: there is no update or delete path anywhere in this codebase for this model —
// no controller route, no service method. This is the entire point of a legal archive: once written,
// a row (and the bytes it points at — see `uri`) is never revised. `documents.service.ts`'s own
// "verify" endpoint RE-HASHES the stored bytes and compares against `contentHash` on every call; it
// never writes the result back here, so even a corruption-discovery run cannot mutate this table.
//
// ## `kind` — added because an audit flagged that "le poller ... n'archive PAS le
// VERDICT, seulement le DÉPÔT"
//
// A DELIVERY row (the default, and the only kind that ever existed before this column) archives
// the artifact actually SENT (Factur-X/FA(3)/PDF). A VERDICT row archives the AUTHORITY'S OWN later
// verdict on that same deposit (PDP fr:201/202/213, KSeF's CLEARED/rejection) — written by
// `conformity/`'s own poller/sweep the moment it observes a TERMINAL status code (never an
// intermediate one — see `AuthorityStatusPoller.isTerminal`), under the exact SAME discipline as a
// DELIVERY row: content-hashed (`archive/hashing.ts`), stored WORM-style (`archive/storage.ts`),
// listed and re-hash-verified by the exact same endpoints. `DocumentAuthorityEvent` (below) remains
// the operational journal (every event, terminal or not, queried live by the conformity panel) — a
// VERDICT archive does not replace it, it ADDS the probative guarantee that journal alone never gave:
// an inaltered, re-hashable record of exactly what the authority said and when it was received.
//
// Chosen over a dedicated table: `DocumentArchive` already owns every column a verdict artifact
// needs (contentHash/uri/artifacts/archivedAt/retentionUntil/retentionBasis) — a second table would
// duplicate all of them for no real gain, and would need its own list/verify endpoints where this one
// already has both. A `kind` discriminator is the sober addition; the two kind-specific extra columns
// below are both nullable so existing (DELIVERY) rows and the migration that adds this column need no
// backfill beyond the enum's own default.
enum DocumentArchiveKind {
  DELIVERY
  VERDICT
}

model DocumentArchive {
  id         String           @id @default(cuid())
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  document   DocumentInstance @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  // See this model's own header. Every row written before this field existed is DELIVERY (the
  // default) — the only kind that existed at the time.
  kind DocumentArchiveKind @default(DELIVERY)

  // VERDICT rows only: the DELIVERY archive of the SAME document this verdict attests to — resolved
  // once, at write time, to the most recent DELIVERY row for the document (`archive/persistence.ts#
  // createAuthorityVerdictArchive`). NULL for a DELIVERY row (nothing to point at). This is a
  // convenience for querying "the verdict(s) for this deposit" from SQL — the archived VERDICT
  // artifact's own bytes ALSO carry this same reference (documentId + the parent's own contentHash),
  // verbatim, so the probative value never depends on this foreign key surviving: even the JSON bytes
  // alone, read off disk with no database at all, name which deposit they attest to.
  parentArchive   DocumentArchive?  @relation("DocumentArchiveVerdictOf", fields: [parentArchiveId], references: [id], onDelete: SetNull)
  parentArchiveId String?
  verdictArchives DocumentArchive[] @relation("DocumentArchiveVerdictOf")

  // VERDICT rows only: `${documentId}|${providerId}|${statusCode}` — the dedup key that makes
  // archiving a terminal verdict idempotent under a re-poll or a redelivered queue job (the identical
  // `@@unique([documentId, providerId, statusCode])` discipline `DocumentAuthorityEvent` already
  // holds below, reused here as a single unique column since this table's own `documentId` already
  // scopes the row). NULL for a DELIVERY row: a re-send legitimately archives more than once (see
  // this model's own header), so DELIVERY rows must never collide with each other on this account —
  // a unique index over a nullable column allows any number of NULLs in Postgres, which is exactly
  // what lets that keep happening unaffected by this column's existence.
  verdictKey String? @unique

  // SHA-256 (hex) over EVERY artifact in this archive, each one framed by a stable
  // `role|mime|byteLength\n` header before its own bytes — see archive/hashing.ts's own header for
  // why a bare concatenation would let two different artifact sets collide into the same digest, and
  // why this framing rules that out. Covers the artifact SET as an ordered whole: reordering,
  // mutating, adding, or removing an artifact all change this hash.
  contentHash String

  // Where the artifact bytes actually live — `file://<path>` under DOCUMENTS_ARCHIVE_DIR (defaulting
  // to `<cwd>/.documents-archive`), content-hash-addressed so re-archiving byte-identical artifacts
  // is idempotent. No S3/WORM object storage in this wave — see archive/storage.ts's own header for
  // the honesty note this carries forward from `avant-refonte-documents`'s own WormS3ArchiveProvider.
  uri String

  // The artifacts THIS archive covers — role/mime/byteLength/sha256 PER ARTIFACT (its own plain
  // hash, unframed — what `verify` names as "expected" for THAT one artifact when it reports
  // CORRUPTED), never the bytes themselves (those live at `uri`, see storage.ts). E.g., for an
  // invoice sent by email: `[{ role: "pdf", mime: "application/pdf", byteLength, sha256 }]`; for one
  // deposited to the PDP: `[{ role: "facturx", mime: "application/pdf", ... }]` — never both invented
  // for a transport that only ever delivered one (see transports/*-transport.ts's own headers). For a
  // VERDICT row: always exactly one artifact, `{ role: "authority-verdict", mime: "application/json",
  // ... }` — see `archive/verdict-artifact.ts`.
  artifacts Json

  archivedAt DateTime @default(now())

  // The country-is-data retention rule (⚖, archive/retention/, same file-
  // per-country/provenance-mandatory mould as documents/mentions/) resolved for the ISSUING
  // company's own country at `archivedAt`. NULL for a country with no declared retention rule at all
  // — see retention/compute-retention.ts's own header: archiving still happens (integrity is owed to
  // every company), but no duration is ever invented. `retentionBasis` is ALWAYS set (even when
  // `retentionUntil` is null) — it names either the rule(s) applied or says plainly that none exist.
  //
  // VERDICT rows are the ONE exception to "resolved at THIS row's own archivedAt": a verdict proves
  // the fate of its deposit, it has no retention life of its own (see this model's own header)
  // — both fields are copied VERBATIM from `parentArchive` instead of being
  // recomputed, so a verdict is never kept a day less (or more) than the deposit it attests to.
  retentionUntil DateTime?
  retentionBasis String?

  // Which version of the retention CALCULATION (`retention/calc-version.ts`) produced the two fields
  // above, at the moment THIS row was written — never touched again afterwards, same WORM discipline
  // as every other column here. NULL for every row written before this column existed, which includes
  // every row from before the origin-axis fix (`cf2e7323`: `retentionUntil` used to be counted from
  // `archivedAt` alone, up to a year too EARLY — see `retention/compute-retention.ts`'s own header)
  // but is not proven to be LIMITED to those: see `retention/calc-version.ts`'s own header for why
  // `retentionBasis`'s TEXT cannot tell the two apart, which is the reason this column exists at all.
  // Deliberately NO `@default` — a migration that adds this column must never backfill a value for a
  // row it did not itself write. Recomputing an already-written archive record is refused outright,
  // so this column NAMES the gap rather than closing it. Read by
  // `document-archive-section.tsx`: NULL renders a "this date may be stale" notice next to
  // `retentionUntil`, never the reverse (a set value never claims certainty this row is CORRECT,
  // only that it was computed by the version named — see calc-version.ts for why unmarked rows are
  // still treated as possibly-stale rather than silently trusted).
  retentionCalcVersion Int?

  @@index([companyId, documentId])
}

// WHICH STORE a journal row below names. The two are not interchangeable: an ARCHIVE row addresses
// ONE archive's own bytes by the uri that archive itself recorded, while an INBOUND row addresses a
// whole company-prefixed directory/key-prefix at once (received-invoice deposits, expense
// attachments and branding logos all share it — `documents/received-invoices/storage.ts`'s own
// header), which is the only unit that store exposes for deletion.
enum PendingStorageErasureKind {
  ARCHIVE
  INBOUND_PREFIX
}

// The WRITTEN-DOWN INVENTORY of a company's stored bytes, taken in the same transaction that removes
// the rows which used to point at them — so that deleting a company can never again leave files
// behind that nothing is able to name.
//
// ## Why this table has to exist at all
//
// `DocumentArchive.uri` was the ONLY pointer to an archived document's bytes, and the archive path
// is `<root>/<documentId>/<contentHash>/` — `companyId` appears NOWHERE in it. Delete the company
// and Postgres cascades `DocumentInstance` → `DocumentArchive` away, taking every uri with it: the
// bytes stay on the volume (or in the bucket) and no scan can afterwards decide which of them
// belonged to the deleted company. Still there for a subpoena or a breach, gone for the customer who
// asked to be erased. A row here is what survives that cascade and keeps them nameable.
//
// ## Why `companyId` is a plain String and NOT a relation
//
// A `@relation` onto `Company` would cascade away with the very deletion this table exists to
// outlive — the table would be empty at exactly the moment it is needed. Same reasoning, and the
// same shape, as `Log.companyId` above (see that column's own comment): a row whose `companyId` no
// longer resolves to a live company is the NORMAL state here, not an anomaly.
//
// ## What a crash leaves behind
//
// Rows are inserted INSIDE the deletion transaction, so the journal exists if and only if the
// company is really gone (never a journal naming a live company's files, which a later drain would
// happily delete). Erasure itself runs AFTER that commit and marks each row `erasedAt` as it goes,
// so a crash at any point leaves a queryable remainder — `WHERE erasedAt IS NULL` — rather than
// silence. `lastError` names why the last attempt on a row failed.
model PendingStorageErasure {
  id String @id @default(cuid())

  // The company these bytes belonged to. NOT a foreign key, deliberately — see this model's header.
  companyId String

  kind PendingStorageErasureKind

  // WHAT to delete, in the exact form that store's own delete primitive takes: for ARCHIVE, the
  // `DocumentArchive.uri` verbatim (`file://…` / `s3://…`, self-describing across a provider switch —
  // `documents/archive/storage.ts`'s own header); for INBOUND_PREFIX, the companyId itself, which is
  // the whole addressing unit that store deletes by. Stored even when it duplicates `companyId` so a
  // row read on its own, by an operator with no code in front of them, still names its own target.
  target String

  // ARCHIVE rows only: which document these bytes archived, kept purely so an operator reading the
  // journal after the fact can tell one orphaned directory from another. NULL for INBOUND_PREFIX.
  documentId String?

  // ARCHIVE rows only, copied VERBATIM from the `DocumentArchive` row before it was cascaded away —
  // never recomputed here (the country catalog, the issue date and the calculation version that
  // produced it are all gone by then). `retentionUntil` in the FUTURE means a statute still requires
  // these bytes kept (⚖ `documents/archive/retention/`), so the drain deliberately skips the row and
  // leaves it pending; `retentionBasis` carries the citation that says which statute. NULL/NULL for a
  // country with no declared retention rule, and for INBOUND_PREFIX rows (no per-file retention
  // exists for that store).
  retentionUntil DateTime?
  retentionBasis String?

  journaledAt DateTime  @default(now())
  // NULL while the bytes are still there. Set once, when they are actually gone.
  erasedAt    DateTime?
  // Why the last erasure attempt on this row failed — never cleared on success (the row carries
  // `erasedAt` by then), so a row that needed two attempts still says what went wrong on the first.
  lastError   String?

  // Re-journaling the same target for the same company is a no-op rather than a duplicate: several
  // `DocumentArchive` rows legitimately share one uri (content-hash addressing makes re-archiving
  // byte-identical artifacts land back on the same path — `archive/storage.ts#archiveDir`).
  @@unique([companyId, kind, target])
  // The operator's query: "what is still on disk that nothing else can name any more?"
  @@index([erasedAt])
}

// The post-deposit CONFORMITY journal — the reconstruction TODO's own named remainder: a PDP/KSeF
// deposit today succeeds the moment the PLATFORM ACCEPTS the upload (`DocumentInstance.transportRef`,
// lifecycle status "sent") and nothing ever follows up on the platform's own later verdict
// (fr:200 déposée → fr:201 émise → fr:202 reçue, or fr:213 rejetée). This table is that follow-up:
// one row per PLATFORM-REPORTED event, written by the conformity sweep (`conformity/`), and read back
// as a timeline + a badge on the document screen.
//
// ## APPEND-ONLY, on purpose — the exact same discipline as DocumentArchive above
//
// No update/delete API exists anywhere in this codebase for this table (see
// `conformity/authority-events.persistence.ts`'s own header) — once written, a row is never mutated.
// A platform's OWN lifecycle is itself an append-only sequence of facts (fr:200 does not stop being
// true the moment fr:201 arrives); recording it any other way (e.g. one row per document, overwritten
// on every poll) would throw away the very history a rejection's own root cause needs ("was BT-23
// ever cited before the final verdict flipped?" — see `pdp/pdp.live.spec.ts`'s own header for exactly
// that kind of question, asked for real during this branch's own work).
//
// ## Why the document's own `status` NEVER changes because of a row here
//
// The declared lifecycle (`DocumentInstance.status`) is the record of the USER'S OWN ACTS — draft,
// sending, sent — driven entirely by `actions/async-send.ts`. The platform's conformity verdict is a
// DIFFERENT fact: an EXTERNAL authority's opinion about a delivery that already, genuinely, happened.
// Folding fr:213 (rejected) back into `status` would conflate "we did not deliver this" (false — the
// deposit WAS accepted and IS sitting on the platform) with "the platform is unhappy with what we
// delivered" (true, and actionable, but a different axis entirely) — exactly the same reasoning
// `DocumentInstance.lastArchiveError`'s own comment already holds for why archiving failure is never
// folded into `lastActionError` either. A rejection is surfaced as a BADGE, projected from this
// table (`conformity/` + the frontend's own conformity section), never as a status transition — a
// human still sees it just as loudly (the whole point of building this), but the descriptor's own
// lifecycle graph (`descriptors/lifecycle.ts`) stays exactly what it has always been: the truth of
// what THIS application did, not a mirror of what a third party thinks of it.
//
// ## Dedup key: (documentId, providerId, statusCode) — not the platform's own per-event id
//
// SuperPDP's own `events[]` (`transports/pdp/pdp-client.ts#SuperPdpInvoiceEvent`) carries an OPTIONAL
// numeric `id` per event — not guaranteed present on every payload shape the client already
// tolerates (see that interface's own comment), and no such per-event id exists at all for a
// a provider whose own API instead answers with a single current-status SNAPSHOT on each call (KSeF's
// own `invoiceStatus` — polled repeatedly, never a list of past events). A dedup key that only some
// providers could ever supply is not a general mechanism. `statusCode` is, by construction, the one
// thing every poller (`conformity/authority-status-poller.ts`) always produces, and this table's own
// lifecycle is monotonic per provider (fr:200 happens once, fr:201 happens once, ...) — two polls
// that observe the SAME status code for the SAME document are, by definition, reporting the same
// underlying fact, never two distinct ones. `@@unique` below is enforced at the DATABASE, not merely
// checked in application code first: `authority-events.persistence.ts`'s own `createMany({
// skipDuplicates: true })` is what makes two genuinely CONCURRENT sweep passes race safely — proven
// against a real Redis/Postgres by `queue/__tests__/document-conformity-queue.redis.spec.ts`.
model DocumentAuthorityEvent {
  id         String           @id @default(cuid())
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  document   DocumentInstance @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  // Which registered transport/poller reported this — 'pdp' | 'ksef' | … (never 'sdi': see
  // `conformity/pollers/`'s own header on why it has no poller registered at all), OR the sweep
  // ITSELF for a synthetic event (still the document's own `channelProviderId` — a synthetic event is
  // scoped to the same provider it gave up on / was blocked polling, never a bare "unknown").
  providerId String

  // The platform's own code, verbatim — 'fr:200'/'fr:201'/'fr:202'/'fr:213' for PDP (see
  // `pollers/pdp-status-poller.ts`), a KSeF status code for 'ksef' (see that poller's own header for
  // how it maps a KSeF response, and the honesty note on why it is NOT live-verified), OR one of the
  // two SWEEP-OWNED synthetic codes this table also carries: 'poll:gave-up' (the max poll age was
  // exceeded — `DOCUMENT_CONFORMITY_MAX_POLL_AGE_MS` — with NO terminal verdict ever observed) and
  // 'poll:blocked' (the channel's credentials were missing/invalid at poll time). Never a bare status
  // number without its provider prefix — see the unique index below for why the PAIR is what matters,
  // not this column alone.
  statusCode String
  // The platform's own human-readable label for `statusCode` (e.g. "Reçue par la plateforme") —
  // verbatim, never translated/reworded here; i18n of the SURROUNDING UI chrome is a frontend concern
  // (`locales/en/translation.json`), this column is what the AUTHORITY itself said.
  statusText String?
  // Populated ONLY on a rejection (PDP's own `events[].data.reason` — see `pdp-client.ts`'s own
  // `SuperPdpInvoiceEvent.data.reason` comment) or a synthetic event's own explanation (gave-up:
  // states the age limit; blocked: the credential error's own message). Null for an ordinary
  // non-terminal/accepted event, which the platform gives no "reason" for in the first place.
  reason     String?
  // The RAW payload this event was extracted from — the platform's own JSON object (PDP: one entry
  // of `events[]`; KSeF: the `InvoiceStatusResponse` polled) — kept verbatim, never re-derived, so a
  // mapping bug discovered later (the exact "read `invoice.status_code` instead of `events[]`"
  // mistake this whole task exists to fix) can be diagnosed from what was ACTUALLY received, not
  // trusted blind from this table's own already-interpreted columns. Null for a synthetic event
  // (gave-up/blocked), which has no platform payload to keep.
  rawPayload Json?

  // WHEN THE PLATFORM ITSELF recorded this event (PDP's own `events[].created_at`) — never the
  // moment THIS application happened to poll and notice it (that is `createdAt` below). A synthetic
  // event (gave-up/blocked, which the platform never reported) sets this to the sweep's own "now" at
  // the moment it fired — the only honest value available for a fact this application invented, not
  // observed.
  observedAt DateTime
  createdAt  DateTime @default(now())

  // See this model's own header — the dedup key a concurrent sweep race relies on.
  @@unique([documentId, providerId, statusCode])
  @@index([companyId, documentId])
}

// Public download links — a token that lets an unauthenticated
// caller download ONE document instance's PDF, on the model of the removed compliance engine's own
// PdfDownloadToken (git tag `avant-refonte-documents`, backend/src/modules/pdf-links/) with the same
// security discipline: `tokenHash` is a SHA-256 digest of a 256-bit `crypto.randomBytes` value — the
// raw token is NEVER stored, and (unlike a password) never needs to be, since `tokenHash` is only
// ever looked up by EXACT match (a unique index), not compared byte-by-byte — there is no timing
// oracle to close here, the same reasoning the removed compliance engine's own service already
// carried in its header.
//
// Two differences from the removed compliance engine's own model, both deliberate:
//  - `typeId` replaces `PdfDocumentType` (a closed two-value enum: QUOTE/INVOICE) — this codebase no
//    longer has a fixed set of document types (documents/descriptors/), so the type is a plain
//    string, exactly like `DocumentInstance.typeId` itself.
//  - `revokedAt` is NEW: the removed compliance engine's own token was a short-lived (1h), throwaway
//    link minted by an MCP chat tool with no screen to revoke it from. THIS feature is a persistent,
//    LISTED link a company hands to a client — see share-links/share-links.service.ts's own header
//    for why its default expiry is deliberately NOT the removed compliance engine's 1 hour.
//    Revocation is a SOFT delete (never a hard one): who shared what, and when it was pulled back, is
//    itself information worth keeping —
//    the same "immutable history" instinct `DocumentArchive` above already holds, though this row
//    (unlike an archive) DOES get one further write: the moment it is revoked.
model DocumentDownloadToken {
  id         String           @id @default(cuid())
  tokenHash  String           @unique
  typeId     String
  document   DocumentInstance @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String

  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([documentId])
}

// "Electronic signature — module removed" — REINTRODUCED, dynamically (the
// "request-signature" ACTION, `documents/actions/request-signature.ts`, declared on the quote
// descriptor like any other action, gated by the same country-policy/status/implementation/
// validation four-gate `runAction` already runs for everything else) rather than as the standalone
// `modules/signatures/` module git tag `avant-refonte-documents` carried, and HARDENED against the
// published vulnerability that module shipped (GHSA-vhjw-gwc5-pjfp): an 8-digit `Math.random()` OTP,
// stored and compared in the clear, behind an anonymous endpoint with zero rate-limiting, gated by
// nothing but the SIGNATURE ROW'S OWN `id` — a UUID is not a secret, so anyone who could enumerate,
// leak, or merely log-scrape one bypassed the OTP check entirely.
//
// This model closes both gaps the same way `DocumentDownloadToken` above already closes the
// equivalent one for a plain download link:
//  - the link's ONLY secret is `tokenHash` (a hashed, 256-bit random token — see
//    `signatures/signature-token.ts`, the exact `share-link-token.ts` pattern), resolved by an exact
//    unique-index lookup, NEVER the row's own `id`.
//  - the OTP itself is a CSPRNG value (`signatures/otp.ts` — `crypto.randomInt`, never
//    `Math.random`), stored HASHED (`otpCodeHash`, never in the clear) and compared in constant time
//    (`crypto.timingSafeEqual` on the digests).
//
// `otpFailedAttempts` is the actual guarantee: a LIFETIME counter (never reset by a re-armed OTP —
// see `otpResendCount` below and `signatures.service.ts`'s own header for the exact brute-force-budget
// math) that PERMANENTLY invalidates this row (`lockedAt` set, `isActive` flipped to false — the
// SAME two fields a threshold-triggered lock and an ordinary "signed, done" write both set, so a
// caller checking `isActive` alone already catches both) the instant it reaches
// `MAX_FAILED_ATTEMPTS`. `otpResendCount` is a SEPARATE, much looser cap (`MAX_OTP_MINTS` — see
// `otp.ts`) on how many times a fresh code may be minted at all; re-arming narrows the CURRENT code's
// own validity window (`otpExpiresAt`) but never touches the lifetime attempt budget, which is the
// one fact that must never grow no matter how many times a legitimate client asks for a new code.
//
// Unlike `DocumentDownloadToken`, this row carries no `expiresAt` of its own: the ONLY expiring fact
// here is the current OTP's own `otpExpiresAt` (5-minute window) — a signature request otherwise
// stays valid (pending a code) until it is either completed (`signedAt`) or permanently locked
// (`lockedAt`). `typeId` stays a plain, open string (never a hardcoded "quote") for the same reason
// `DocumentDownloadToken.typeId`/`CompanyChannelConfig.providerId` do — only "quote" declares this
// action today, but nothing here assumes it always will.
model Signature {
  id         String           @id @default(cuid())
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  typeId     String
  document   DocumentInstance @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  // The link's ONLY secret — see this model's own header. Never `id` above.
  tokenHash String @unique

  // The current OTP challenge, if one was ever minted — see `signatures/otp.ts`. Both null until the
  // first "POST .../otp" call; left in place (never cleared) once signed, matching
  // `DocumentDownloadToken`'s own "never delete, only judge from the surrounding fields" posture.
  otpCodeHash  String?
  otpExpiresAt DateTime?

  // LIFETIME counters — see this model's own header for the exact guarantee each bounds. Neither is
  // ever decremented, and `otpFailedAttempts` is never reset by anything in this codebase, including
  // a fresh OTP mint.
  otpFailedAttempts Int @default(0)
  otpResendCount    Int @default(0)

  // Set the instant `otpFailedAttempts` reaches `MAX_FAILED_ATTEMPTS` — PERMANENT, independent of
  // `otpExpiresAt`/any later re-arming. `isActive` is flipped to false on the SAME write (see this
  // model's own header) so a caller only ever needs to check ONE field either way.
  lockedAt DateTime?

  signedAt DateTime?

  // Flipped to false the instant this row stops being usable — either the lifetime lock above fires,
  // OR the sign actually succeeds (a completed signature must never be replayable), OR a fresh
  // signature request supersedes it (see `signatures.service.ts`'s own `requestSignature`). Named
  // `isActive` (not `revokedAt`, unlike `DocumentDownloadToken`) for continuity with the ORIGINAL,
  // now-removed module's own column.
  isActive Boolean @default(true)

  // The FROZEN "what the signer reviewed" snapshot — both null until the first "GET .../document"
  // call. `documents.service.ts#renderInstancePdf` is built fresh on every call and is NOT
  // byte-stable across renders (PAdES-BES embeds a real signing timestamp when the company has an
  // active certificate), so a re-render at sign time could never be trusted to match what was shown
  // earlier. Instead the PDF is rendered ONCE, on the first view, and its bytes are written to the
  // SAME durable, content-addressed store the legal archive uses (`archive/storage.ts`) — `documentPdfUri`
  // is that store's own URI, `documentPdfHash` its SHA-256. Every later view reads back these exact
  // bytes rather than rendering again, which is what actually makes "what the signer saw" and "what
  // gets sealed" the same artifact, not merely two renders that are expected to agree.
  documentPdfUri  String?
  documentPdfHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
  @@index([companyId])
}

// The one-time confirmation code gating `danger/` (`POST /danger/otp` then `reset/app`|`reset/all`) —
// used to be a SINGLE, process-wide in-memory field (`Math.random()`, plain-text, `===` comparison, no
// lockout): one company's OWNER minting a code silently overwrote whatever another company's OWNER had
// just been emailed. One row per company (`companyId` is the unique key, never `id`) fixes the
// cross-tenant collision; the CSPRNG/hash/timing-safe-compare/lockout hardening itself is
// `documents/signatures/otp.ts`'s own, reused rather than re-invented (`danger-otp.persistence.ts`'s
// own header).
//
// Unlike `Signature`, a fresh mint (`POST /danger/otp`) DOES reset `failedAttempts` — this challenge
// sits behind an already-authenticated OWNER session (`@Roles(OWNER)`), never a bearer link a third
// party could probe anonymously, so re-arming is a deliberate, freshly-authorized request rather than
// a possible attacker's do-over. What must still never reset is the lock itself: once `lockedAt` is
// set, `danger-otp.persistence.ts#mintDangerOtp` refuses to mint a replacement at all — this action
// stays locked for the company until the row is manually cleared, matching `Signature`'s own
// "PERMANENT, independent of any later re-arming" posture for the one field that actually carries the
// guarantee.
model DangerOtp {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String  @unique

  codeHash  String
  expiresAt DateTime

  failedAttempts Int       @default(0)
  lockedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Instance-wide reset's own OTP challenge (`modules/instance/instance-reset.service.ts`) — the SAME
// hardening `DangerOtp` above documents (CSPRNG code, hashed storage, timing-safe compare, a
// permanent lifetime lock after too many failed attempts), keyed by the REQUESTING OPERATOR's e-mail
// rather than a `companyId`: an instance operator is an `INSTANCE_OPERATOR_EMAILS` allowlist entry
// (`lib/instance-operators.ts`), never a row this schema owns a relation to — this challenge must
// keep working for an email the allowlist names even if no `User` row has ever signed up with it, and
// must survive that operator's own `User` row being wiped by the very reset it is authorising. One
// row PER OPERATOR (never a single instance-wide singleton) so one operator's own 5-guess lockout can
// never block a DIFFERENT operator's own, independent attempt.
model InstanceResetOtp {
  id    String @id @default(cuid())
  email String @unique

  codeHash  String
  expiresAt DateTime

  failedAttempts Int       @default(0)
  lockedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The client portal — a long-lived, revocable, hashed-random-token
// credential scoped to ONE (company, client) pair, generalizing DocumentDownloadToken's "one
// document's own public link" shape to "one client's own account" (every document the descriptors'
// own `clientVisible` flag exposes, plus their aggregate balance). Minted by a company member
// ("Invite to portal", client-portal/portal-tokens.service.ts — the same staff-triggered, ONE-TIME-
// shown-then-copyable shape ShareLinksService already holds for a document link), emailed to the
// client's own contactEmail when one is on file, and used by an anonymous browser as a bearer
// credential (`Authorization: Bearer <token>`, never a cookie — see client-portal/portal-auth.guard.ts's
// own header for why) on every `/api/portal/*` call. Never handed to `runAction`/`ActionRegistry`:
// nothing a portal session does is a document ACTION — only reads, plus the two narrow writes
// (`refuseQuote`/`requestSignature`, both delegating to EXISTING mechanisms) client-portal/portal.
// service.ts exposes.
//
//  - The link's ONLY secret is `tokenHash` (a hashed, 256-bit random token — see
//    client-portal/portal-token.ts, the exact share-link-token.ts pattern), resolved by an exact
//    unique-index lookup, NEVER the row's own `id`.
//  - Revocation is a SOFT delete (`revokedAt`), never a hard one — same "immutable history" posture
//    DocumentDownloadToken already holds: who was invited, and when access was pulled back, is worth
//    keeping.
//  - `lastUsedAt` is informational only (surfaced on the staff-facing list so "has this client ever
//    actually opened their portal" is answerable at a glance) — nothing in this codebase branches on
//    it; unlike `expiresAt`/`revokedAt`, it is never part of whether a token still resolves.
model ClientPortalToken {
  id        String  @id @default(cuid())
  tokenHash String  @unique
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([clientId])
}

// The per-(company, type) monotonic counter numbering/sequence.ts's `bumpSequence` advances — see
// that file's header for why this is the ONLY code path allowed to write here (a single atomic
// `INSERT ... ON CONFLICT DO UPDATE ... RETURNING`, run inside the SAME transaction as the
// DocumentInstance write that actually consumes the number — never on its own). `nextNumber` is the
// NEXT number this sequence will hand out; a `(companyId, typeId)` pair with no row here yet has
// never taken a number, meaning the next one is 1 (this column's own default, for any OTHER code
// path that might create a row — application code never relies on that default, see sequence.ts).
//
// ⚖ On "no-gap" sequences: some jurisdictions treat a document numbering sequence's CONTINUITY (no
// gaps) as a legal property of the numbering itself (France's own invoice.save-draft rule, see
// country-policy/data/fr.json, is already grounded in the neighboring idea that an ISSUED invoice is
// intangible) — this table does not assert that claim, sourced or not: see numbering/sequence.ts's
// own header for exactly what this mechanism does and does not guarantee about gaps, and
// country-policy/data/fr.json's top-level `notes` for the honest, unverified flag on the legal
// question itself.
model DocumentNumberSequence {
  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  typeId     String
  nextNumber Int     @default(1)

  @@id([companyId, typeId])
}

// The persistent, atomic PEC filename progressivo counter — see
// `transports/sdi-pec/pec-protocol.ts#nextPecProgressivo`'s own header for why this replaced a
// SHA-1-hash-derived progressivo (measurable birthday-paradox collisions well within real submission
// volume) and why it is scoped by `idTrasmittente` (a fact about the SdI TRASMITTENTE identity, per
// §5.1.1's own uniqueness rule) rather than by this codebase's own companyId — deliberately no
// `Company` relation: `idTrasmittente` can outlive a single company row (channel credentials can be
// re-entered), and this counter's only job is never handing out the same 5-character value twice for
// the same trasmittente, nothing tenant-scoped. `nextValue` is a plain `INT` (§2.2's own 5-character
// base36 ceiling is ~60M, nowhere near needing a BIGINT).
model PecFilenameSequence {
  idTrasmittente String @id
  nextValue      Int    @default(1)
}

// Mirror of backend/src/modules/documents/country-policy/data/*.json, seeded (never hand-edited —
// see country-policy/seed.ts) by seedCountryPolicies(), which is idempotent on
// (countryCode, typeId, actionId). A company whose country has NO row at all here has every
// document action blocked — see country-policy/country-policy.ts's evaluateCountryPolicy(), the
// one place this table is read at request time. A row's `allowed: false` is a genuine legal or
// unverified PROHIBITION (see provenanceKind); a (typeId, actionId) simply absent from a country's
// rows is refused the same way — an allow-list, not a deny-list.
model DocumentCountryActionRule {
  id          String  @id @default(cuid())
  countryCode String // ISO 3166-1 alpha-2, uppercase — matches the source file's own countryCode
  typeId      String // a DocumentTypeDescriptor.id, e.g. "invoice" — never validated against the
  // live DocumentTypeRegistry here: the policy file and the descriptor registry are two
  // independently-maintained sources, exactly like the VAT rate catalog and tax-engine.ts used to be
  // (see the removed compliance module's tax-rates/consistency.spec.ts for that same shape of risk).
  actionId    String // a DocumentActionDescriptor.id, e.g. "send"
  allowed     Boolean

  // Provenance — see country-policy/schema.ts's PolicyProvenance. Exactly one of the two shapes
  // below is populated, enforced by assertValidProvenance() before a row is ever written, never by
  // a DB constraint: a rule with neither is a bug in the seed, not a state this table should be
  // able to represent silently.
  provenanceKind  String // 'legal' | 'unverified'
  sourceText      String? // 'legal': the exact legal text this rule is based on
  sourceCheckedAt DateTime? // 'legal': when `sourceText` was last checked against its source
  resolutionNote  String? // 'unverified': what would have to be checked to settle this rule

  // Narrows an ALLOWED rule to specific document lifecycle statuses (documents/descriptors/
  // lifecycle.ts) — see country-policy/schema.ts's DocumentActionRuleFact.statuses for the full
  // contract. Empty (the default) means no narrowing beyond the document type's own rules — same
  // "empty array, not null, means nothing extra" convention `documentTypes` already established one
  // layer up (registry.ts's `typesFor`), and ignored entirely when `allowed` is false.
  statuses String[] @default([])

  notes String? // free-form caveats, same convention as VatRateFact.notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryCode, typeId, actionId])
  @@index([countryCode])
}

// Mirror of backend/src/modules/documents/country-identifiers/data/*.json, seeded (never
// hand-edited — see country-identifiers/seed.ts) by seedCountryIdentifierRequirements(), which is
// idempotent on (countryCode, scheme). A country with NO row at all here has NO identifier
// requirement declared at all — see country-identifiers/country-identifiers.ts's
// resolveRequiredIdentifiers(), the one place this table is read at request time, for why that
// state is surfaced with a `reason` to the frontend rather than a silently empty form. This is a
// SEPARATE concern from DocumentCountryActionRule above: that table says which document ACTIONS a
// country allows; this one says which national identifier SCHEMES (SIRET, EIN, VAT…) a party of a
// given type must supply — neither reads the other.
model CountryIdentifierRequirement {
  id          String  @id @default(cuid())
  countryCode String // ISO 3166-1 alpha-2, uppercase — matches the source file's own countryCode
  scheme      String // a stable, cross-country key the FRONTEND switches on — e.g. "LEGAL_ID", "VAT"
  // (see client-upsert.tsx's `data-cy={`client-identifier-${req.scheme}`}` and
  // company.settings.tsx/onboarding.tsx's own `req.scheme === "LEGAL_ID"` special case). Changing
  // a shipped scheme string is a breaking change to those data-cy targets, not a free rename.
  appliesTo   String // 'COMPANY' | 'INDIVIDUAL' | 'BOTH'
  label       String // country-specific display text for this scheme, e.g. "SIRET" (FR), "EIN" (US)
  required    Boolean
  pattern     String? // optional validation regex — a legal CLAIM like `required`, covered by the
  // same provenance below, never a UI-invented default
  helpText    String?

  // Provenance — see country-identifiers/schema.ts's IdentifierProvenance. Exactly one of the two
  // shapes below is populated, enforced by assertValidProvenance() before a row is ever written,
  // never by a DB constraint — same discipline as DocumentCountryActionRule above.
  provenanceKind  String // 'legal' | 'unverified'
  sourceText      String? // 'legal': the exact legal text this fact is based on
  sourceCheckedAt DateTime? // 'legal': when `sourceText` was last checked against its source
  resolutionNote  String? // 'unverified': what would have to be checked to settle this fact

  notes String? // free-form caveats, same convention as DocumentActionRuleFact.notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryCode, scheme])
  @@index([countryCode])
}

// B2G routing table — mirror of backend/src/modules/documents/b2g-routing/data/*.json, ONE row per
// country. Answers a single question, per the CLIENT's own country (never the seller's): when this
// invoice's recipient is a GOVERNMENT client (Client.kind), which channel/format is imposed, which
// identifiers must already be on that client, and which document fields must be filled in before
// sending is allowed at all.
//
// Upserted AT BACKEND BOOT (b2g-routing/boot-upsert.service.ts's OnModuleInit), DELIBERATELY NOT
// `prisma/seed.ts` (the Prisma migrate/reset hook `DocumentCountryActionRule` above still uses) — see
// that service's own header for why. In short: `prisma/seed.ts` only runs after `migrate dev`/
// `migrate reset`/`db seed`, exactly the gap an earlier finding named as "`resetAndSeed` ne re-sème pas la
// politique pays" for DocumentCountryActionRule — a NEW rule added to data/*.json would
// otherwise only reach an already-migrated, already-booted database (e2e's own `cy.resetAndSeed()`,
// a self-hosted instance that never re-runs `db seed`) via a manual reseed nobody remembers to run.
// Running the identical idempotent upsert from `OnModuleInit` instead means EVERY process that boots
// — the API inline, or a scaled worker replica — brings THIS table to match the data files itself, no
// separate step to forget. This fixes that reseed gap for THIS table specifically; every OTHER
// mechanism (DocumentCountryActionRule, CountryIdentifierRequirement) keeps its existing prisma-seed
// path unchanged — see b2g-routing/boot-upsert.service.ts for the full reasoning.
//
// The READ side (b2g-routing/b2g-routing.ts) reads THIS TABLE, never the data files directly — the
// same DB-mirror split DocumentCountryActionRule already holds, deliberately kept even though a
// single in-memory catalog (channel-policy/'s own choice) would be simpler for one instance: every
// API/worker replica must see the SAME rule the instant ANY of them boots with a newer data file, not
// whichever one happened to load the newest code first.
model B2gRoutingRule {
  id           String @id @default(cuid())
  countryCode  String @unique // ISO 3166-1 alpha-2, uppercase — the CLIENT's own country, never the
  // seller's: a B2G rule is a regime of the DESTINATION, exactly like directive 2014/55/UE itself
  // (obligations bind the receiving contracting authority) — see actions/invoice-actions.ts's own
  // header on the precedence this implies (B2G > the seller-country channel mandate > the company's
  // free transport choice).
  transportId  String // a transports/transport-registry.ts id — deliberately NOT validated against the
  // live registry at load time (same reasoning as channel-policy/schema.ts's own `providerId`): a
  // rule may legitimately name a transport that does not exist YET (e.g. "chorus-pro", "zre-ozgre") —
  // sending then refuses loudly, naming exactly that channel, never a load-time crash for an
  // intentionally-unimplemented one. This IS the model's own thesis, not an oversight — see
  // actions/invoice-actions.ts's header.
  formatSyntax String // a formats/format-registry.ts id, e.g. "facturx", "xrechnung", "fatturapa"

  // [{ scheme, label, why }] — `scheme` matches a PartyIdentifier.scheme on the CLIENT; a government
  // client missing one of these blocks sending, naming the field, the screen, and `why` verbatim.
  requiredClientIdentifiers Json @default("[]")
  // [{ field, label, why, required }] — `field` matches a top-level key of the INVOICE's own `data`
  // (e.g. "buyerReference"); `required: true` blocks sending when absent, `required: false` is
  // informational only (shown as a help hint, never a block) — see FR's own "code service" entry for
  // why that distinction exists.
  requiredDocumentFields    Json @default("[]")

  // Provenance — same two-shape discipline as DocumentCountryActionRule/CountryIdentifierRequirement
  // above (never a DB constraint, enforced by assertValidB2gRoutingFact before a row is ever written).
  // Unlike channel-policy's own `requirement: 'mandated'`, an 'unverified' B2G rule is still LOADED
  // and still ENFORCED — every row in this table is inherently a mandate (there is no "suggested"
  // tier for B2G routing, see b2g-routing/schema.ts's own header) — 'unverified' only ever means the
  // underlying legal text was not independently re-checked at its primary source in this pass, never
  // "this rule is optional".
  provenanceKind  String // 'legal' | 'unverified'
  sourceText      String? // 'legal': the exact legal text this rule is based on
  sourceCheckedAt DateTime? // 'legal': when `sourceText` was last checked against its source
  resolutionNote  String? // 'unverified': what would have to be checked to settle this rule

  notes String? // free-form caveats, same convention as the models above

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode])
}

// National transport channels — REPRISED from git tag `avant-refonte-documents`
// (`channel-credentials.service.ts`'s own model there), same shape: one row per (company, provider,
// environment) a company has connected a national transport for. `providerId` names a registered
// `documents/transports/transport-registry.ts` entry (e.g. "pdp") — the value `Company.
// invoiceTransportId` (above) is set to once connected; `channel` is the broader category
// (`"PDP"`) that groups whatever specific provider implementation a company picked, matching
// this catalog's own first-wave scope (KSeF/SdI belong to a later wave — just more rows the exact
// same shape covers). `config` is the credential blob — AES-256-GCM encrypted at rest
// (`utils/secret-crypto.ts`, which survived the compliance-engine demolition unchanged) — a
// plain, unencrypted JSON column would put a client secret directly in a DB dump. `ChannelEnvironment`
// already existed in this schema (added for the removed compliance engine, additive-only policy —
// see the "COMPLIANCE LIFECYCLE PERSISTENCE" section below); it is reused here rather than
// redeclared, same TEST/PROD shape the old channel-credentials service already needed.
model CompanyChannelConfig {
  id          String             @id @default(cuid())
  companyId   String
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel     String // broad category, e.g. "PDP" — see this model's own header
  providerId  String // 'pdp' | 'ksef' | 'sdi' | … — a documents/transports/transport-registry.ts id
  environment ChannelEnvironment @default(TEST)
  config      String // AES-256-GCM encrypted JSON blob (credentials + non-secret config)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // A per-row opaque identifier a company can embed in a PUBLIC callback URL it registers with a
  // foreign authority that only supports declaring ONE fixed reception endpoint per registration
  // (SdI's own SDICoop accreditation — `documents/transports/sdi/sdi-notifiche.controller.ts`'s own
  // header: "can a company register a distinct URL per company with this authority" is answered
  // there, and this column is the "yes" half of that answer). Generated once, in `upsertChannelConfig`'s
  // `create` branch ONLY — an ordinary credential update never touches it, because the URL a company
  // pastes into a third-party accreditation portal must keep resolving to the SAME company for as
  // long as this row exists, including across a later credential rotation. Stored in the CLEAR,
  // deliberately, unlike `config` above: this value is a SCOPING label a caller presents to say which
  // company a request is for, never itself the boundary that decides whether a request is trusted at
  // all — that boundary is a separate, per-endpoint shared secret this column plays no part in
  // (`SDI_NOTIFICHE_SHARED_SECRET`). Hashing it here would cost the one thing it actually needs:
  // being shown back to the company whenever it must be re-pasted into a portal, possibly long after
  // it was first generated — unlike a bearer share-link token, nothing is lost by keeping it legible.
  // Still 256 random bits regardless, so it is never a matter of guessing it. Null for every row
  // created before this column existed, and for any provider that never needed a public per-company
  // callback in the first place (most of them) — nothing backfills it; it is generated the next time
  // that row is reconnected.
  pushToken String? @unique

  @@unique([companyId, providerId, environment])
  @@index([companyId])
}

// A company's own PAYMENT METHOD configuration — which of `payment-methods/*.descriptor.ts`'s
// registered methods it accepts, and the values it supplies for each one's own COMPANY-level fields
// (a PayPal e-mail, a cheque payee...). Plain, UNENCRYPTED `Json`: every field every BUILT-IN method
// declares today is something the payer is meant to SEE (an account e-mail, a payee name) — never a
// secret an attacker reading a DB dump could use, the same "printed, not a credential" distinction
// `CompanySigningCertificate`'s own header draws for Portugal's ATCUD validation code. A method whose
// FUTURE field genuinely IS a credential (an API key, a client secret) must not be added here — it
// belongs in `CompanyChannelConfig` above instead, through `ChannelCredentialsService`, the same
// encrypted store (`CREDENTIALS_ENCRYPTION_KEY`) every national transport already uses.
//
// `bank_transfer` is the ONE documented exception, but only for its FIELD VALUES: the two fields
// (IBAN/BIC) already had a home before this feature existed — `Company.iban`/`Company.bic`, the
// columns the pre-existing SEPA-QR feature (`rendering/sepa-qr.ts`) already reads — so
// `payment-methods/persistence.ts` bridges reads/writes of THOSE to those columns instead
// of this table's own `config`, rather than inventing a second, possibly-drifting place to hold the
// same fact. A row for `methodId: "bank_transfer"` still exists here, the same as for every other
// method — its `enabled` flag is a genuinely SEPARATE choice from "is an IBAN on file" (a company may
// keep an IBAN on file for the SEPA QR alone while not offering "Bank transfer" as an accepted method,
// or vice versa) — only this one row's own `config` column is never read, always left `{}`.
//
// `enabled` is what a company's own "which methods do I offer" choice writes — a method with fields
// filled in but `enabled: false` keeps its values on file (so re-enabling it later doesn't ask again)
// without being offered to a payer or printed on a document. Absent row for a given `methodId`: the
// method is simply unconfigured — every consumer (the invoice's "Payment methods" PDF/email section,
// `record-payment`'s own `method` options) treats that exactly like `enabled: false`, never a crash.
model CompanyPaymentMethodConfig {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  methodId  String // a payment-methods/payment-method-registry.ts id, e.g. "paypal"
  enabled   Boolean  @default(false)
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, methodId])
  @@index([companyId])
}

// Custom fields ("champs personnalisés") — which kind of record a `CompanyCustomField`
// attaches to. Kept a closed, two-value enum (never a free string, unlike `documentTypeId` below):
// unlike a document TYPE (open, third-party-extensible — DocumentTypeRegistry), "client" vs. "document"
// is a property of THIS core's own data model, the same reason `WidgetLocation` (descriptors/types.ts)
// is a closed union rather than an open string.
enum CompanyCustomFieldTarget {
  CLIENT
  DOCUMENT
}

// Custom fields ("champs personnalisés") — a company's own field, added to its clients or
// to one (or every) document type, without touching code: the SAME "a country is data" principle
// country-fields/ already applies to a COUNTRY's difference from the trunk, scaled to a COMPANY's own
// difference from the trunk. See `company-custom-fields/types.ts`'s `toFieldDescriptor` for how a row
// here becomes a real `DocumentFieldDescriptor` (DOCUMENT target) or a `Client.customFields` entry
// (CLIENT target), and that function's own header for why a DOCUMENT-target value is stored under a
// `custom:`-prefixed key rather than the bare one below.
//
// `key` is chosen ONCE, at creation (slugified from `label` — see the persistence layer), and NEVER
// changes afterward: it is the join between an ALREADY-PERSISTED document/client's stored value and
// this definition, so changing it would either strand every value already on file under the OLD key or
// silently reattach them to a field that means something else now. Renaming is `label` alone — safe at
// any time, since every consumer (the form, the list, the PDF) always reads the CURRENT row's `label`
// at render time, never a value frozen onto the document/client itself (the same "labels are current,
// not versioned" convention `DocumentFieldDescriptor.label` already holds).
//
// DELETION is soft (`archivedAt`), for the reason the feature's own spec names explicitly: "un document
// émis est immuable". An archived definition disappears from the CREATE/EDIT surface (a brand-new or
// still-editable record can no longer be given a value for it) but keeps resolving wherever a value for
// it ALREADY EXISTS on file — an issued invoice's PDF, its entry in the document list, an existing
// client's own read view — so archiving a definition can never make an already-recorded fact
// unreadable. Nothing here ever deletes a value: `Client.customFields`/a `DocumentInstance.data` entry
// keyed by this row's `key` survives this row's own archival (or, in principle, physical deletion)
// forever, exactly the way a country overlay's own 'remove' operation never touches data already
// persisted before the country's rules changed.
model CompanyCustomField {
  id             String                   @id @default(cuid())
  companyId      String
  company        Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  target         CompanyCustomFieldTarget
  // DOCUMENT target only: a DocumentTypeDescriptor.id (e.g. "invoice"), or NULL to mean "every
  // document type" — deliberately NOT validated against DocumentTypeRegistry (same declared
  // independence country-fields/schema.ts's own `TypeFieldOverlay.typeId` already keeps, for the same
  // reason: a plugin's own type may not be registered yet when this row is seeded). Always NULL for a
  // CLIENT-target row — a client has no "type" for this to narrow.
  documentTypeId String?
  // Immutable after creation — see this model's own header.
  key            String
  label          String
  // One of the RESTRICTED subset of CORE_FIELD_KINDS this feature offers — see
  // `company-custom-fields/types.ts#ALLOWED_CUSTOM_FIELD_KINDS` for the closed list and why it is
  // narrower than the full core set (no 'array'/'reference'/'file'/... — a company-defined field is a
  // single scalar value, never a structural one). Plain `String`, not a Prisma enum: validated at the
  // application layer the same way `CompanyFieldOverlayOperation`'s own `field.kind` already is,
  // because it must stay in lockstep with a TypeScript union living in application code, not the
  // schema.
  kind           String
  // 'select' only — `{ value: string; label: string }[]`, the exact shape
  // `DocumentFieldDescriptor.options` already has. NULL for every other kind.
  options        Json?
  required       Boolean                  @default(false)
  // Display/entry order among this company's OTHER definitions for the SAME (target, documentTypeId)
  // scope — never a global order across scopes, which would be meaningless (a client-target field has
  // no business being interleaved with an invoice-only one).
  order          Int                      @default(0)
  // Soft-delete — see this model's own header for the full "why".
  archivedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  // One key per (company, target, document type) scope — a CLIENT-target row and a DOCUMENT-target row
  // for a DIFFERENT type may reuse the same human-chosen key without colliding, since each becomes its
  // own storage key once resolved (see this model's own header on `custom:` prefixing).
  //
  // NOTE — Postgres treats two NULLs as UNEQUAL for uniqueness, so this constraint does NOT by itself
  // stop two "applies to every document type" (`documentTypeId: NULL`) rows from sharing a key: the
  // service layer (persistence.ts#assertKeyAvailable) re-checks that specific case before insert. Kept
  // as a real DB constraint anyway for every OTHER case (a specific `documentTypeId`, or CLIENT target)
  // — belt for the common case, the application-level check is the brace for the NULL one.
  @@unique([companyId, target, documentTypeId, key])
  @@index([companyId])
}

// Enriched expense categories ("notes de frais enrichies") — per-company expense categories. Product
// decision 2026-09-15, OVERRIDING this feature's own original shipped design: `expense.descriptor.ts`
// used to hardcode a closed `EXPENSE_CATEGORY_OPTIONS` list (with an "Other" catch-all), reasoning at
// the time that no per-company "write your own list" mechanism existed anywhere in this codebase (see
// that file's OWN prior header, still readable via git history on this model's introducing commit).
// `CompanyCustomField` (the custom-fields feature) shipped that exact mechanism afterwards — but a company custom field
// is always a NEW field bolted on top of a type (`company-custom-fields/persistence.ts#toFieldDescriptor`,
// `custom:`-prefixed key), never a per-company override of an EXISTING native field's own `options`.
// Expense categories need the latter: the expense descriptor's own `category` field keeps its native,
// un-prefixed key (every already-recorded expense's `data.category` value stays meaningful), while
// WHICH values are offered/valid becomes per-company data resolved at `describeTypeForCompany`/
// `runAction` time — see `expense-categories/persistence.ts#applyExpenseCategoriesView`, which reuses
// `country-fields/apply-overlay.ts`'s 'modify' operation to patch that ONE field's `options`, the same
// reuse-not-reinvent precedent `applyCompanyCustomFieldsView` already set for its own, different case.
model ExpenseCategory {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // The value actually stored on an expense's `data.category` — immutable once created (same
  // reasoning as `CompanyCustomField.key`'s own header: renaming it would silently reinterpret every
  // expense that already carries it). Derived from `label` at creation time
  // (expense-categories/persistence.ts#slugify) and never accepted from the caller.
  key        String
  // The only thing "rename a category" (`PUT /api/documents/expense-categories/:id`) ever changes.
  label      String
  // Soft-delete, same discipline as `CompanyCustomField.archivedAt`'s own header: an expense that
  // already carries an archived category's `key` keeps reading it forever (this table is resolved
  // with `includeArchived: true` for THAT case — see `resolveActiveExpenseCategoryOptions`'s own
  // header) — archiving only removes a category from the create/edit FORM's own offered options.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  // One key per company — see this model's own header on why `key` is derived, not caller-supplied,
  // and why it is immutable: nothing here needs the NULL-scope carve-out `CompanyCustomField`'s own
  // unique constraint comment documents (`documentTypeId` doesn't exist on this model at all).
  @@unique([companyId, key])
  @@index([companyId])
}

// Per-company OIDC single sign-on — a large customer registering ITS OWN identity provider, without
// the operator touching this instance's environment. Storage mirrors `CompanyChannelConfig` just
// above: the secrets live in ONE opaque AES-256-GCM blob (`credentials`, `utils/secret-crypto.ts`,
// key `CREDENTIALS_ENCRYPTION_KEY`) and every NON-secret knob is a plain column, so the settings
// screen can show what is configured without ever decrypting anything — the same reason
// `CompanySigningCertificate` below extracts notBefore/notAfter at upload time instead.
//
// There is no `providerId` column, deliberately: the provider id is DERIVED from the company id as
// "c_<companyId>" (`lib/sso-policy.ts#companyProviderId`). better-auth resolves a provider by
// matching one flat string `id` — `sign-in/social` against `c.body.provider`, `callback/:id` against
// `c.params.id` — so the company must be recoverable from that single string, and the redirect URI a
// customer registers at its own IdP is therefore /api/auth/callback/c_<companyId>. A stored id column
// could drift from the company it names; a derived one cannot.
//
// `companyId` is UNIQUE for that same reason: the provider id carries nothing but the company, so two
// rows for one company would be indistinguishable at resolution time. One company, one IdP.
//
// `emailDomains` backs the @Public() email-first lookup (GET /api/sso/lookup). It is NEVER trusted on
// its own — see `domainsVerifiedAt`.
model CompanySsoProvider {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // What the sign-in button says ("Acme SSO"). Non-secret, hence a plain column.
  label String

  // Either `discoveryUrl` alone — the ordinary OIDC case, where better-auth's generic-OAuth plugin
  // fetches .well-known and derives the rest (including the JWKS it verifies id_tokens against) — or
  // the endpoints spelled out. Never both sets required: `lib/sso-policy.ts#ssoEndpointsComplete` is
  // the single place that decides whether a row is actually usable.
  discoveryUrl     String?
  authorizationUrl String?
  tokenUrl         String?
  userInfoUrl      String?

  scopes String[] @default(["openid", "profile", "email"])

  // AES-256-GCM encrypted JSON carrying clientId + clientSecret — ONE blob, never a column per
  // secret and never a second crypto scheme (`CompanyChannelConfig.config`'s own discipline).
  credentials String

  // Per-domain ownership claims and their verification state — see CompanySsoDomain below. This used
  // to be a single `emailDomains String[]` plus one `domainsVerifiedAt DateTime?` for the WHOLE array,
  // which cannot be made safe: verify "acme.com", then append "gmail.com" to the same array, and
  // "gmail.com" reads as verified too even though nothing ever checked it. Verification must be
  // per-domain, hence its own table (see that model's header for the rest of the reasoning, including
  // why there is deliberately no global unique index on `domain`).
  domains CompanySsoDomain[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One domain a company CLAIMS to own, and whether that claim has been PROVEN via a DNS TXT challenge
// (see `lib/sso-domain-verification.ts`). Split out of `CompanySsoProvider` (which used to carry a bare
// `emailDomains String[]` plus one `domainsVerifiedAt` for the whole array) because verification is
// inherently a PER-DOMAIN fact — a single timestamp for an array cannot express "acme.com is proven but
// gmail.com, added later, is not" without either lying about the second domain or invalidating the
// first every time the array changes.
//
// `domain` is bare and lowercased ("acme.com", never "@acme.com") — see `normalizeDomains` in
// `lib/sso-policy.ts`, the single normaliser both the provider row and this table go through.
model CompanySsoDomain {
  id String @id @default(cuid())

  // The FK to the CompanySsoProvider ROW this claim belongs to. Named `providerId` because that is
  // this table's own foreign key column, following ordinary Prisma convention for the relation field
  // `provider` below — but be careful: everywhere ELSE in this feature "providerId" means the
  // better-auth provider STRING id ("c_<companyId>", see `sso-policy.ts#companyProviderId`), which is
  // NOT what this column holds. This column holds a `CompanySsoDomain`'s parent row's cuid.
  providerId String
  provider   CompanySsoProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  domain String

  // The random value the caller must publish in DNS (see `buildVerificationRecordValue`). Re-minted
  // every time an already-claimed-but-unverified domain is re-added, so a stale, possibly-leaked token
  // from a previous attempt is never still accepted.
  token String

  // NULL until the DNS TXT challenge actually resolves — see `sso.controller.ts`'s verify route,
  // the ONLY place this column is ever written. `resolveSsoLookup` (`lib/sso-policy.ts`) treats a null
  // value here exactly as strictly as the old, whole-array `domainsVerifiedAt` did: no match without it.
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Deliberately scoped to (providerId, domain), NOT a bare `@@unique([domain])` on its own: a global
  // unique index would let whichever company claims a domain FIRST — verified or not — permanently
  // block every other company from even attempting to claim it, and the 409/constraint violation
  // itself would leak the fact that some other tenant already typed that domain into their settings
  // screen. Neither is acceptable for a claim that hasn't been proven yet. The actual security
  // property — two companies cannot BOTH end up verified for the same domain — is enforced instead at
  // VERIFICATION time (`sso.controller.ts#verifyDomain`, inside a transaction): whichever row is
  // verified FIRST wins, and a later verification attempt for the same domain by a different provider
  // is refused with a 409 that names only the domain, never the other company.
  @@unique([providerId, domain])
}

// "Electronic signature — module removed" — a company's OPT-IN electronic
// signing capability, reprised (schema unchanged, field-for-field) from git tag
// `avant-refonte-documents`'s own `CompanySigningCertificate`. See
// `modules/company/signing-certificates/signing-certificates.service.ts`'s own header for the full
// reasoning: no jurisdiction this product ships requires a signed document today, so this table is
// never read by anything unless a company chooses to upload a certificate here.
//
// `applicability` is "*" (all algorithms) or one of "XAdES"/"CAdES"/"PAdES" — a bare `String`, not an
// enum, the same reasoning `CompanyChannelConfig.providerId` above gives (an open, provider-declared
// vocabulary, not a closed set this schema would have to migrate for a fourth algorithm). `serial`
// is likewise a `String` (hex, arbitrary length after node-forge strips leading zeros) — never an
// `Int`, a certificate serial is an identifier, not a quantity.
//
// `encryptedPfx`/`encryptedPass` are TWO INDEPENDENT AES-256-GCM ciphertexts (`utils/secret-crypto.ts`)
// — never one derived from the other, the same discipline `CompanyChannelConfig.config` holds for a
// whole credentials blob. `notBefore`/`notAfter`/`serial`/`subject` are extracted from the PFX by
// node-forge AT UPLOAD TIME (never trusted from the client) precisely so the LIST endpoint can show a
// certificate's real validity/subject without ever decrypting it.
model CompanySigningCertificate {
  id            String             @id @default(cuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label         String
  applicability String             @default("*") // "*" | "XAdES" | "CAdES" | "PAdES"
  environment   ChannelEnvironment @default(TEST)
  encryptedPfx  String // AES-256-GCM encrypted base64 PFX (secret-crypto) — never the plaintext bytes
  encryptedPass String // AES-256-GCM encrypted PFX password (secret-crypto) — a SEPARATE ciphertext
  notBefore     DateTime
  notAfter      DateTime
  serial        String
  subject       String
  isActive      Boolean            @default(true) // soft-delete only — see the service's own "deactivate()"
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([companyId, applicability, environment])
  @@index([companyId])
}

// Portugal's ATCUD — the AT (Autoridade Tributária) "código de validação" a company obtains from the
// Portal das Finanças for one (série documentaire × tipo de documento) pair, BEFORE issuing any
// document in that series (AT FAQ 4308/4312, quoted verbatim in country-policy/data/pt.json's own
// `invoice.send` notes). Shaped after `CompanySigningCertificate` above (per-company, scoped store,
// settings-screen upsert/list/delete) with ONE deliberate difference: `validationCode` is stored IN
// THE CLEAR, never through `secret-crypto.ts` — unlike a signing certificate's PFX/password, this
// code is not a secret, it is PRINTED on every invoice the series produces (Portaria n.º 195/2020,
// art. 4.º n.º 1), so encrypting it at rest would protect nothing while making it harder to read back
// for the settings screen that lists what is configured.
//
// `seriesId` is this company's own ATCUD "série" identifier — the part of its number-format pattern
// (Company.numberFormats, numbering/format-number.ts) that comes BEFORE the mandatory "/{number...}"
// suffix numbering/atcud.ts's `parseAtcudPattern` requires for a Portuguese invoice, rendered through
// that same pattern's `{year}`/`{month}`/`{day}` tokens (numbering/atcud.ts's `renderAtcudSeriesId`)
// — e.g. "FT 2026" for a company numbering "FT {year}/{number:4}". A company that resets its series
// every year therefore needs a NEW row (and a NEW code from the AT) every year, which is the correct,
// literal reading of "per série" (FAQ 4312: "específico para cada conjunto composto pelo identificador
// de série e pelo tipo de documento"), not a per-company or per-document-type-only fact.
//
// `typeId` is a DocumentTypeDescriptor.id — "invoice" for every row this product can produce today
// (see numbering/atcud.ts's own header on why "credit-note" cannot: it has no `numbering` declared at
// all in this branch), kept as a real column rather than hard-coded so a future numbered, fiscally-
// relevant PT type needs no schema change, only a new row.
model CompanyAtcudSeries {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  typeId         String
  seriesId       String
  validationCode String // AT "código de validação" — NOT a secret, see this model's own header. Plain text.
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, typeId, seriesId])
  @@index([companyId])
}

