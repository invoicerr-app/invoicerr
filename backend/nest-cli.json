{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "tsc",
    "deleteOutDir": true,
    "watchAssets": true,
    "assets": [
      { "include": "**/*.json", "outDir": "dist/src" },
      { "include": "**/*.md", "outDir": "dist/src" },
      { "include": "**/*.pem", "outDir": "dist/src" },
      { "include": "**/*.xsd", "outDir": "dist/src" },
      { "include": "**/*.sch", "outDir": "dist/src" },
      { "include": "**/*.woff2", "outDir": "dist/src" }
    ],
    "plugins": ["@nestjs/swagger"]
  }
}
