POSTGRES_DB="invoicerr"
POSTGRES_USER="invoicerr_user"
POSTGRES_PASSWORD="password"
DATABASE_URL="postgresql://invoicerr_user:password@localhost:5432/invoicerr"

APP_URL="https://invoicerr.chevrier.dev" # Change this to your production URL
# This also IS better-auth's own base URL (lib/auth.ts passes it as the `baseURL` option): the
# library only ever falls back to a BETTER_AUTH_URL env var when no `baseURL` option was given at
# all, and this app always gives one — so there is no separate BETTER_AUTH_URL to set here.

# BACKEND_PUBLIC_URL: optional, defaults to APP_URL — set it ONLY when a third-party server (Mollie's
# webhook, an inbound plugin webhook) must reach this backend at a DIFFERENT address than the browser
# uses (e.g. a tunnel exposing just the backend while developing without a public domain yet).
# BACKEND_PUBLIC_URL="https://your-tunnel.example.com"

# CORS_ORIGINS: comma-separated list of extra allowed origins (besides APP_URL above, which main.ts
# always allows — and http://localhost:5173, allowed OUTSIDE production only, see lib/dev-origins.ts).
# Only needed when the frontend is served from an origin other than APP_URL itself (e.g. a separate
# domain, or a non-standard dev port).
# CORS_ORIGINS="https://app.example.com,https://admin.example.com"

# PORT: the backend's own listen port. Default 3000 (main.ts) when unset.
# PORT=3000

# SWAGGER_BASIC_AUTH_USER / SWAGGER_BASIC_AUTH_PASSWORD: outside production, /api/docs (the interactive
# API explorer) is always mounted, unauthenticated, exactly as before. In production it is NOT mounted
# at all unless BOTH of these are set — SwaggerModule bypasses every Nest guard (see
# lib/swagger-basic-auth.ts's own header), so leaving it open by default in production would hand any
# anonymous visitor the full route/DTO map. Set both to expose it anyway, gated behind HTTP Basic Auth.
# SWAGGER_BASIC_AUTH_USER=""
# SWAGGER_BASIC_AUTH_PASSWORD=""

# INSTANCE-level mail provider — the "société → instance → refus nommé" cascade's fallback tier.
# A COMPANY can also set its OWN mail server in Settings → Mail (PUT /api/company/mail-settings,
# stored encrypted in CompanyChannelConfig) — that one wins over everything below when it exists;
# the variables here are only the fallback used for a company that never configured its own.
#
# MAIL_PROVIDER selects the provider EXPLICITLY: "smtp" | "resend". Leave it UNSET to auto-detect
# instead (mail.service.ts#resolveInstanceMailProviderId): RESEND_API_KEY present -> "resend" (wins
# even if SMTP_* is also set); otherwise "smtp" (the historical default). Setting MAIL_PROVIDER
# explicitly always wins over auto-detection — an existing "smtp" deployment keeps selecting smtp
# even if a RESEND_API_KEY is later added to the same environment by mistake.
# There used to be a third value, "brevo" (a dedicated Brevo HTTP-API provider) — removed (product
# decision, 2026-09-15). MAIL_PROVIDER=brevo now fails loudly at boot instead of silently falling
# back to something else. Brevo is still usable — see the SMTP example below, which already points
# at Brevo's own SMTP relay.
# MAIL_PROVIDER="smtp"
MAIL_FROM="me@host.com" # Sender address used by the Resend provider (falls back to SMTP_FROM / SMTP_USER)

# SMTP Configuration (used when MAIL_PROVIDER=smtp, or nothing else is configured). The example below
# uses Brevo's own SMTP relay — Brevo has no dedicated provider any more, but its SMTP relay works
# like any other SMTP host here.
SMTP_HOST="smtp-relay.brevo.com" # Change this to your SMTP host
SMTP_USER="XXXXX@smtp-brevo.com" # Change this to your SMTP user
SMTP_FROM="me@host.com" # Change this to your email address (not required if SMTP_USER is the same)
SMTP_PASSWORD="XXXXX" # Change this to your SMTP password
SMTP_PORT=587 # Change this to your SMTP port (default is 587 for TLS)
SMTP_SECURE=false # Set to true if your SMTP server requires a secure connection (default is false)

# Resend Configuration (used when MAIL_PROVIDER=resend, or auto-detected — see above)
RESEND_API_KEY="" # https://resend.com/api-keys — uses the Resend HTTP API instead of SMTP

# REQUIRED: strong random string used to sign auth sessions. Generate with: openssl rand -base64 32
# Falls back to JWT_SECRET if unset (JWT_SECRET itself is otherwise not read anywhere — set ONE of
# the two, BETTER_AUTH_SECRET is the documented/recommended one).
#
# EVERY environment except NODE_ENV=test: the backend REFUSES TO BOOT (lib/secret-guard.ts, called
# from main.ts) if the effective value (this var, or JWT_SECRET as the fallback) is empty OR a known
# placeholder string ("your_jwt_secret", "changeme", anything starting with "your_"/"change_me"/… —
# see that file's own list). This exists because this exact file and docker-compose.yml both used to
# ship a non-empty PUBLIC example value, so a copy-pasted-unmodified deployment booted with a
# session-signing secret anyone could read on GitHub — and an unset/misspelled/"staging" NODE_ENV used
# to boot on that same placeholder with zero warning. Only NODE_ENV=test (`.env.test`, `npm test`) is
# exempt — better-auth's own internal default secret covers it, and it never sets this var at all.
BETTER_AUTH_SECRET=""

# DISABLE_AUTH: set to "1" or "true" (case-insensitive, surrounding whitespace ok) to close
# OPEN SELF-REGISTRATION on this instance — despite the name, it does NOT disable login.
# By default anyone can create an account (and, having none, lands on the company-creation
# wizard); with this set, a new account can only be created with a valid invitation code
# from an existing company member. The very first account on a fresh instance is always
# allowed through regardless, so a brand-new deployment with this already set isn't
# permanently unbootstrappable.
# DISABLE_AUTH="false"

# OIDC Configuration (example for Authentik). createOidcConfig() (backend/src/lib/auth.ts, via
# sso-policy.ts's resolveOidcEndpoints()) resolves endpoints EITHER by discovery OR from the manual
# *_ENDPOINT variables below — NEVER both: it checks OIDC_DISCOVERY_URL first, and when that is set
# the three manual endpoints are never even read. Pick ONE of the two options below; the other is
# commented out here on purpose so copy-pasting this file cannot silently set variables that get
# dropped.

# Option A (active below) — discovery: the IdP's discovery document supplies the authorization,
# token and userinfo endpoints on its own. (OIDC_JWKS_URI is still accepted as a legacy alias for
# this variable, for anyone who already set it — but it took a discovery-DOCUMENT URL, never a JWKS
# one, so the name was renamed to say what it actually is.)
OIDC_DISCOVERY_URL="https://auth.chevrier.dev/.well-known/openid-configuration"

# Option B — manual endpoints, for an IdP with no discovery document. To use this instead, uncomment
# the three lines below AND comment out OIDC_DISCOVERY_URL above.
# OIDC_AUTHORIZATION_ENDPOINT="https://auth.chevrier.dev/authorize"
# OIDC_TOKEN_ENDPOINT="https://auth.chevrier.dev/token"
# OIDC_USERINFO_ENDPOINT="https://auth.chevrier.dev/userinfo"

# RP-Initiated Logout: when set, signing out of this app also signs out at the IdP (better-auth's
# generic-OAuth plugin builds a provider logout URL from this and redirects to it). Without it,
# sign-out clears only the local session and the user stays signed in at the IdP.
OIDC_END_SESSION_ENDPOINT="https://auth.chevrier.dev/end_session"

# Client ID and Secret for OIDC
# OIDC_CLIENT_ID is what decides whether this instance registers the environment provider at all.
# OIDC_NAME is its id: it ends up in a URL path segment (/api/auth/callback/<id>) and is sanitised to
# URL-safe characters, defaulting to "oidc" when unset. Setting OIDC_NAME without OIDC_CLIENT_ID
# registers nothing, and the sign-in page correctly shows no button.
OIDC_CLIENT_ID="your-client-id"
OIDC_CLIENT_SECRET="your-client-secret"

# OIDC_ONLY: set to "1" or "true" (case-insensitive) to make this instance SINGLE-SIGN-ON ONLY —
# email/password sign-in and sign-up are disabled, and POST /api/auth-extended/set-password is refused
# (better-auth does not gate setPassword behind the flag itself, so without that refusal a signed-in
# user could still mint a password and the flag would be cosmetic). DEFAULT OFF.
#
# Works with the environment provider above AND/OR with the per-company providers a customer registers
# for itself in company settings -> SSO (each gets its own provider id, "c_<companyId>", and its own
# redirect URI — that screen shows the exact URI to register at the IdP).
#
# The backend REFUSES TO BOOT if this is set while no OIDC provider exists at all — neither
# OIDC_CLIENT_ID above nor any company-registered one — because nobody, you included, could sign in,
# and configuring the first provider itself requires being signed in.
# OIDC_ONLY="false"

# Compliance async queue (BullMQ/Redis) — see QUEUE_IMPL_PLAN.md
# Prefer REDIS_URL when set (e.g. "redis://:pass@redis:6379"); otherwise the connection is
# composed from REDIS_HOST/REDIS_PORT/REDIS_PASSWORD below.
#
# `.env.test.local` (gitignored, holds real per-developer credentials such as PDP sandbox creds) is
# NOT loaded by `npm run start:test` — deliberate, learned from a real incident. Loading it before
# `.env.test` dropped `.env.test`'s own Redis variables here (dotenv-cli does not layer multiple env
# files the way that setup assumed): the backend then booted with no working queue connection,
# `send` silently did nothing, and two Cypress specs failed for a reason that had nothing to do with
# them. Diagnosis: `NOAUTH Authentication required` in the boot log.
#
# To run a live spec that needs credentials from `.env.test.local` (e.g. PDP), source it yourself in
# the shell instead of relying on `npm run start:test` to load it:
#   cd backend && set -a; . .env.test.local; set +a
#   PDP_LIVE=1 npx jest pdp-live --no-coverage --runInBand
# The e2e scenario that exercises this (spec 31) needs no server-side PDP credentials itself — it
# connects the channel with FAKE credentials, through the API, against a server that doesn't exist
# (closed port); it's the live jest spec above, not Cypress, that talks to the real superpdp sandbox.
# It does need CREDENTIALS_ENCRYPTION_KEY below, without which the channel connection fails with 503
# before ever reaching the network — that key lives in `.env.test` (committed) instead of
# `.env.test.local`, since it only encrypts a throwaway test database (invoicerr_db), never a
# production secret, and `npm run start:test` loads only `.env.test` (see the NOAUTH trap above).
# REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ROLE: "api" (default, this app) or "worker" (dedicated compliance queue worker process, see
# backend/src/worker.ts). Read by the root entrypoint.sh ROLE switch.
ROLE="api"

# WORKER_INLINE: when true (default; anything other than the literal string "false" counts as true —
# app.module.ts), the API process also consumes its own queue jobs
# (mono/self-host deployment, one container). Set to "false" only when running dedicated
# worker process(es) (ROLE=worker) elsewhere — see docker-compose.scale.yml.
WORKER_INLINE="true"

# CREDENTIALS_ENCRYPTION_KEY: AES-256-GCM key (32 bytes, hex or base64 — generate with
# `openssl rand -hex 32`) that encrypts per-company channel credentials at rest (national
# transmission channels like PDP/KSeF/SdI connected in company settings, and per-company SSO
# provider secrets) — utils/secret-crypto.ts. NOT gated like BETTER_AUTH_SECRET: leaving this unset
# does NOT crash the app or block boot. `isEncryptionAvailable()` simply returns false, and every
# endpoint that would store or read an encrypted credential (channel connection, per-company SSO)
# answers 503 instead — the feature disables itself silently rather than storing anything
# unencrypted. Required only if you want self-hosted customers to connect their own channel/SSO
# credentials through the app.
# CREDENTIALS_ENCRYPTION_KEY=""

# Online payment — Stripe / Mollie / PayPal. NO env var here connects a
# payment provider: same bring-your-own-account model as every channel above, each company pastes ITS
# OWN credentials in Settings → Payments and they land in the SAME encrypted CompanyChannelConfig
# table CREDENTIALS_ENCRYPTION_KEY above already protects — there is nothing instance-wide to set.
# The *_LIVE / *_API_KEY / *_CLIENT_ID / *_CLIENT_SECRET / *_WEBHOOK_ID variables named in
# documentation/docs/developer-guide/live-testing.md exist ONLY to run this project's own jest live
# specs (a developer's own sandbox/test credentials, never a real deployment's).

# Document-lifecycle sweep intervals (defaults shown, all ms). Each sweep is ONE repeatable BullMQ
# job (never one per company/document) that scans for rows due for the next step — lowering these is
# a test-only knob (backend/.env.test drops them to 5000 so Cypress specs don't need long timeouts);
# raising them trades responsiveness for fewer DB scans. Read directly by each sweep's own
# read*IntervalMs() (currency-rate-sweep.ts, conformity-sweep.ts, reminder-sweep.ts,
# schedule-sweep.ts).
# CURRENCY_RATE_SWEEP_INTERVAL_MS=86400000    # 24h — the ECB publishes once a business day
# DOCUMENT_CONFORMITY_SWEEP_INTERVAL_MS=60000  # 1min — polls channels for a pending verdict
# DOCUMENT_REMINDER_SWEEP_INTERVAL_MS=86400000 # 24h — overdue-payment reminder tiers are day-grained
# DOCUMENT_SCHEDULE_SWEEP_INTERVAL_MS=60000    # 1min — recurring-document occurrences

# DOCUMENT_CONFORMITY_MAX_POLL_AGE_MS: how long a document keeps polling a channel for a terminal
# verdict before the sweep gives up on it (marks it blocked rather than polling forever). Default
# 7 days (604800000ms). conformity-sweep.ts#readMaxPollAgeMs.
# DOCUMENT_CONFORMITY_MAX_POLL_AGE_MS=604800000

# DOCUMENT_ACTION_QUEUE_ATTEMPTS: retry attempts (exponential backoff) for one document action queue
# job (send, transmit, …) before it is left as failed for a human to retry. Default 3.
# document-queue.dispatcher.ts.
# DOCUMENT_ACTION_QUEUE_ATTEMPTS=3

# PDF rendering (invoices/quotes/receipts/credit notes) runs on playwright-core, which bundles no
# browser of its own. CHROMIUM_EXECUTABLE_PATH points it at a Chromium/Chrome binary; the shipped
# Docker image already sets this to the Chromium baked into its base image, so self-hosters running
# that image normally never need to touch it. Only relevant outside Docker (bare-metal/dev) or with a
# custom image that puts Chromium somewhere non-standard — otherwise a handful of conventional system
# paths (/usr/bin/chromium, /usr/bin/chromium-browser, /usr/bin/google-chrome(-stable)) are tried
# automatically, and only an operator with none of those AND this var unset sees the startup error.
# Outside Docker a browser has to come from somewhere: if you don't already have a system Chrome/
# Chromium, run `npx playwright-core install chromium` from backend/ — this is the supported way to
# get one that matches the pinned playwright-core version, and render-pdf.ts finds it on its own
# (via playwright-core's own browser store) with no env var required.
# CHROMIUM_EXECUTABLE_PATH="/usr/bin/chromium"
# PUPPETEER_EXECUTABLE_PATH — legacy alias from when this engine was Puppeteer instead of Playwright.
# Still honoured for anyone who already has it set; prefer CHROMIUM_EXECUTABLE_PATH above for anything
# new.

# PDF_RENDER_CONCURRENCY: how many PDFs this instance renders at once (extra requests queue rather
# than failing). Each one holds a real Chromium page open for its duration, so raising this trades
# memory for throughput. Non-positive or non-numeric values are ignored in favor of the default.
# PDF_RENDER_CONCURRENCY=4

# OCR of unstructured received-invoice PDFs, read by THIS process ("api" role — uploading is a
# plain REST call, never a queue job, so ROLE=worker never needs this). OPTIONAL, and this is the
# ONLY variable involved: leaving it unset means this instance runs full-local, self-host, no OCR
# container at all — a plain scanned PDF stores with empty fields for a human to fill in, exactly as
# before this feature existed. Points DIRECTLY at the OCR ENGINE container — our own ocrmypdf-based
# image (ghcr.io/invoicerr-app/ocr-image, see docker-compose.yml's own "ocr" service, started with
# `docker compose --profile ocr up`) — no intermediate role or process in between, no API key,
# nothing ever leaves this machine. A future non-local engine is its own provider file under
# `plugins/ocr/providers/` (see `plugins/ocr/providers/local/local.ts`'s own header), not a value of
# this variable.
# OCR_SERVICE_URL="http://localhost:9998"

# ─────────────────────────────────────────────────────────────────────────────
# Received-invoice storage and logging (ALL OPTIONAL, sensible self-host defaults)
# ─────────────────────────────────────────────────────────────────────────────
# DOCUMENTS_ARCHIVE_DIR: where signed/archived outbound document artifacts (PDF + audit trail) are
# written on disk. Default: "<process cwd>/.documents-archive" (archive/storage.ts). Point this at a
# persistent volume in any deployment where the container filesystem does not survive a restart.
# DOCUMENTS_ARCHIVE_DIR="/data/documents-archive"
# DOCUMENTS_INBOUND_DIR: where received (inbound) invoice files are stored before/after OCR. Default:
# "<process cwd>/.documents-inbound" (received-invoices/storage.ts). Same persistence caveat as above.
# DOCUMENTS_INBOUND_DIR="/data/documents-inbound"

# FORCE_DEBUG_LOGS: set to "true" to keep debug-level logs in production (NODE_ENV=production
# otherwise suppresses them). logger/logger.service.ts. Never needed outside troubleshooting.
# FORCE_DEBUG_LOGS="true"

# PAYMENT_PROVIDERS_REAL: set to "1" to wire the REAL Stripe/Mollie/PayPal clients even under
# NODE_ENV=test (documents-core.module.ts#shouldUseRealPaymentClients) — no effect outside NODE_ENV=test.
# PAYMENT_PROVIDERS_REAL="1"



# ─────────────────────────────────────────────────────────────────────────────
# Company lookup — national business registers (ALL OPTIONAL, nothing to configure)
# Autofills the company/client forms from the official register of the selected
# country (GET /api/company-lookup). France, Czechia, Slovakia, Poland, Romania,
# Norway, Denmark, Finland, Brazil, Peru and the EU-wide VIES VAT check work with
# no credentials at all, and every other country falls back to the keyless worldwide
# directories (GLEIF LEI index + Peppol Directory). The registers below take a free
# account and only improve the coverage of their own country; leaving them empty is fine.
# ─────────────────────────────────────────────────────────────────────────────
# United Kingdom — https://developer.company-information.service.gov.uk/
# COMPANIES_HOUSE_API_KEY=""
# Ireland — https://services.cro.ie/
# CRO_API_USER=""
# CRO_API_KEY=""
# Netherlands — https://developers.kvk.nl/
# KVK_API_KEY=""
# Switzerland / Liechtenstein — https://www.zefix.admin.ch/ZefixPublicREST/
# ZEFIX_USER=""
# ZEFIX_PASSWORD=""
# Australia — https://abr.business.gov.au/Documentation/Default
# ABR_GUID=""
# New Zealand — https://api.business.govt.nz/api-details#api=nzbn-v5
# NZBN_API_KEY=""
# Peru — optional, lifts the anonymous quota on apis.net.pe
# PE_APISNET_TOKEN=""

# ─────────────────────────────────────────────────────────────────────────────
# ALLOW_PRIVATE_WEBHOOK_URLS — TEST-ONLY. NEVER SET THIS IN PRODUCTION.
# ─────────────────────────────────────────────────────────────────────────────
# Disables the SSRF guard (webhook-url-guard.ts) that blocks a company-configured webhook URL from
# pointing at a private/loopback/link-local address. Exists solely so the e2e webhook-delivery suite
# can point a webhook at its own in-process localhost receiver (set in e2e's own test env, never
# here). Setting "1" in a real deployment lets any user with webhook-config access make this server
# issue requests to its own internal network. See SECURITY_AUDIT.md finding #2.
# ALLOW_PRIVATE_WEBHOOK_URLS="1"

# ─────────────────────────────────────────────────────────────────────────────
# ALLOW_PRIVATE_OUTBOUND_URLS — TEST-ONLY. NEVER SET THIS IN PRODUCTION.
# ─────────────────────────────────────────────────────────────────────────────
# The same kind of escape hatch as ALLOW_PRIVATE_WEBHOOK_URLS above, for the shared SSRF guard
# (utils/outbound-url.ts) used by a company's own SSO/OIDC endpoints and by the PDP/SdI transport
# clients' tenant-configured baseUrl/endpoint. Exists solely for e2e's own local stubs (a fake PDP/SdI
# server, an unresolvable OIDC fixture domain) — set in e2e's own test env, never here. Setting "1" in
# a real deployment lets any user with SSO/channel-config access make this server issue requests to
# its own internal network, and — for SdI — present that tenant's own mTLS client certificate to it.
# ALLOW_PRIVATE_OUTBOUND_URLS="1"

# ─────────────────────────────────────────────────────────────────────────────
# Hosted billing (Polar) — OFF by default. Self-hosted instances: leave everything below commented.
# ─────────────────────────────────────────────────────────────────────────────
# WARNING__ENABLE_BILLING_FOR_USERS__WARNING is the ONE switch for the whole subscription system
# (trial/blocked lifecycle, seat sync, Settings > Subscription, the /api/billing/* route). Unset (the
# default), NOTHING about it exists: no route, no screen, no background job. Only ever set this on the
# operator's OWN hosted offering, never on a self-hosted deployment — see billing/billing-flag.ts.
# WARNING__ENABLE_BILLING_FOR_USERS__WARNING="true"
#
# Everything below is REQUIRED the moment the flag above is set (the backend refuses to boot,
# naming whichever is missing — billing/polar-env.ts) and otherwise entirely unused.
# POLAR_ACCESS_TOKEN — Organization Access Token, Polar dashboard > Settings > Developers.
# POLAR_ACCESS_TOKEN=""
# POLAR_WEBHOOK_SECRET — from the webhook endpoint you configure in Polar to POST
# <APP_URL>/api/billing/webhooks/polar. NOT /api/auth/polar/webhooks — that route existed only through
# @polar-sh/better-auth's own webhooks() sub-plugin, removed 2026-09-15 (its bundled @polar-sh/sdk
# validateEvent() only computes the pre-8-September-2026 signing key — see Polar's own docs,
# polar.sh/docs/integrate/webhooks/delivery, "Custom validation" — a guaranteed 400 for any endpoint
# created after that cutover; see backend/src/modules/billing/polar-webhook.controller.ts's own
# header). This app now verifies the signature itself, at the URL above, trying both keys.
# POLAR_WEBHOOK_SECRET=""
# POLAR_ORGANIZATION_ID — the Polar organization this instance sells under.
# POLAR_ORGANIZATION_ID=""
# POLAR_SERVER — "sandbox" (default; safe even if left unset) or "production". Sandbox and production
# access tokens/products are entirely separate in Polar.
# POLAR_SERVER="sandbox"
# POLAR_PRODUCT_ID_MONTHLY / POLAR_PRODUCT_ID_YEARLY — the two seat-priced products (the actual price
# grid lives in Polar itself, never hardcoded here).
# POLAR_PRODUCT_ID_MONTHLY=""
# POLAR_PRODUCT_ID_YEARLY=""
